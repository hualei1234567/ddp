# 复制为 .env 后按需修改；.env 不入库。
DDP_ENV=local
DDP_APP_NAME=DDP
DDP_APP_VERSION=0.2.0
DDP_LOG_LEVEL=INFO

# 对外元信息 GET /api/v1/platform/meta 的 phase/modules 由配置声明，不在路由里硬编码。
DDP_PLATFORM_PHASE=8

DDP_DATABASE_URL=postgresql+psycopg://ddp:ddp@localhost:5432/ddp
DDP_S3_ENDPOINT=http://localhost:9000
DDP_S3_ACCESS_KEY=minioadmin
DDP_S3_SECRET_KEY=minioadmin
DDP_S3_BUCKET=ddp-raw
DDP_S3_REGION=us-east-1

# 本地开发用；生产必须由环境注入强随机值（至少 32 个字符，且不能是占位符）。
# 非 local 环境若 JWT 配置不完整，应用启动自检会直接拒绝启动。
DDP_JWT_SECRET=replace-me-in-production
DDP_JWT_ISSUER=ddp
DDP_JWT_AUDIENCE=ddp-api
# 校验 exp/nbf 时允许的时钟偏差（秒）。
DDP_JWT_LEEWAY_SECONDS=30
# 令牌有效期策略（分钟）；不参与令牌校验，校验以 token 内 exp 为准。
DDP_JWT_EXPIRE_MINUTES=720

# 仅本地测试/loopback 使用的 Header 认证后门；默认关闭。
# 非 local 环境即使设为 true 也会被启动自检拒绝。
DDP_LOCAL_HEADER_AUTH=false

# 限流后端：memory（默认，进程内计数，仅单实例）或 redis（多副本共享全局配额）。
# 详见 docs/adr/0031-distributed-rate-limit-via-redis.md
DDP_RATE_LIMIT_BACKEND=memory
# 仅 backend=redis 时使用；此时留空或被设为非法 URL 都会让启动自检拒绝启动。
# 容器内运行时由 docker-compose 覆盖为 redis://redis:6379/0。
DDP_RATE_LIMIT_REDIS_URL=redis://localhost:6379/0

# Prometheus 抓取端点 GET /metrics 的访问控制（抓取端是机器，不能用用户 JWT）。
# 留空时：local 环境放行；非本地环境的 /metrics 返回 503（API 仍正常启动）。
# 配置后：必须带 `Authorization: Bearer <token>`，否则 401。
# 非 local 环境建议用 `openssl rand -hex 32` 生成，至少 32 个字符，禁止占位符。
DDP_METRICS_ACCESS_TOKEN=
# 可选来源网段白名单（CIDR 或单地址的 JSON 数组），空数组表示不限制来源。
# 只比对 ASGI 对端地址，不读可伪造的 X-Forwarded-For：反向代理场景把代理地址写进来。
# DDP_METRICS_ALLOWED_SOURCE_NETWORKS=["10.0.0.0/8","192.168.1.0/24"]

# Web 前端（nginx 静态站）在宿主机上的端口。
# 默认 8088 而不是 8080：8080 太容易被本机其他服务占用，Docker 的端口转发
# 在冲突时会**静默失效**（`docker port` 显示映射存在、容器内 nginx 正常，
# 但宿主连接被拒），排查成本很高。
DDP_WEB_PORT=8088
