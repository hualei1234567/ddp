# 复制为 .env 后按需修改；.env 不入库。
DDP_ENV=local
DDP_APP_NAME=DDP
DDP_APP_VERSION=0.2.0
DDP_LOG_LEVEL=INFO

# 对外元信息 GET /api/v1/platform/meta 的 phase/modules 由配置声明，不在路由里硬编码。
DDP_PLATFORM_PHASE=8

DDP_DATABASE_URL=postgresql+psycopg://ddp:ddp@localhost:5432/ddp
DDP_S3_ENDPOINT=http://localhost:9000
DDP_S3_ACCESS_KEY=minioadmin
DDP_S3_SECRET_KEY=minioadmin
DDP_S3_BUCKET=ddp-raw
DDP_S3_REGION=us-east-1

# 本地开发用；生产必须由环境注入强随机值（至少 32 个字符，且不能是占位符）。
# 非 local 环境若 JWT 配置不完整，应用启动自检会直接拒绝启动。
DDP_JWT_SECRET=replace-me-in-production
DDP_JWT_ISSUER=ddp
DDP_JWT_AUDIENCE=ddp-api
# 校验 exp/nbf 时允许的时钟偏差（秒）。
DDP_JWT_LEEWAY_SECONDS=30
# 令牌有效期策略（分钟）；不参与令牌校验，校验以 token 内 exp 为准。
DDP_JWT_EXPIRE_MINUTES=720

# 仅本地测试/loopback 使用的 Header 认证后门；默认关闭。
# 非 local 环境即使设为 true 也会被启动自检拒绝。
DDP_LOCAL_HEADER_AUTH=false

# 限流后端：memory（默认，进程内计数，仅单实例）或 redis（多副本共享全局配额）。
# 详见 docs/adr/0031-distributed-rate-limit-via-redis.md
DDP_RATE_LIMIT_BACKEND=memory
# 仅 backend=redis 时使用；此时留空或被设为非法 URL 都会让启动自检拒绝启动。
# 容器内运行时由 docker-compose 覆盖为 redis://redis:6379/0。
DDP_RATE_LIMIT_REDIS_URL=redis://localhost:6379/0

# Prometheus 抓取端点 GET /metrics 的访问控制（抓取端是机器，不能用用户 JWT）。
# 留空时：local 环境放行；非本地环境的 /metrics 返回 503（API 仍正常启动）。
# 配置后：必须带 `Authorization: Bearer <token>`，否则 401。
# 非 local 环境建议用 `openssl rand -hex 32` 生成，至少 32 个字符，禁止占位符。
DDP_METRICS_ACCESS_TOKEN=
# 可选来源网段白名单（CIDR 或单地址的 JSON 数组），空数组表示不限制来源。
# 只比对 ASGI 对端地址，不读可伪造的 X-Forwarded-For：反向代理场景把代理地址写进来。
# DDP_METRICS_ALLOWED_SOURCE_NETWORKS=["10.0.0.0/8","192.168.1.0/24"]

# 训练 / 模型 Adapter 的真实 HTTP 网关（可选）。
# 值可以是 JSON 对象，也可以是 `adapter_id=url` 逗号分隔；留空或注释掉都表示
# 「未接线」——对应 adapter 的提交/查询/取消仍返回 503
# （training_adapter_unavailable / model_adapter_unavailable），绝不伪造成功。
# 只有登记了 endpoint 的 adapter 才会真正发出 HTTP 请求：
#   训练：POST {url}/training-runs、GET/POST .../training-runs/{id}[/cancel]
#   模型：POST {url}/evaluations、POST {url}/inference-tasks
# 下游 Adapter 的请求体/响应体/错误码约定见
# backend/app/infrastructure/training_adapter_http.py 与 model_platform_http.py 的模块文档。
# DDP_TRAINING_ADAPTER_ENDPOINTS={"mock": "http://127.0.0.1:9100"}
# DDP_MODEL_ADAPTER_ENDPOINTS={"mock": "http://127.0.0.1:9101"}
# 或：DDP_TRAINING_ADAPTER_ENDPOINTS=mock=http://127.0.0.1:9100
#
# 单次 Adapter 调用超时（秒），默认 10。超时按不可用处理（503），不做重试：
# 重试会把"平台不可达"变成一次长时间的静默等待，排障时看不到真实原因。
DDP_TRAINING_ADAPTER_TIMEOUT_SECONDS=10
DDP_MODEL_ADAPTER_TIMEOUT_SECONDS=10
#
# SSRF 守卫的显式本地例外，默认 false。训练 Adapter 出站前会解析 endpoint
# 主机名，拒绝环回/私网/链路本地/云元数据地址（10/8、172.16/12、192.168/16、
# 127/8、169.254/16、::1、fe80::/10、0.0.0.0、组播与保留地址）。
# 本文件下方的 local-adapter endpoint 使用 compose 服务名（私有网段），因此
# **仅本地开发**显式置 true。开启后等同于关闭训练 Adapter 的 SSRF 地址筛查，
# 本机可被用作访问内网与云元数据的跳板；共享/生产环境必须保持 false，并把
# endpoint 配成公网可达地址（或先落地连接级 IP 固定方案）。
DDP_TRAINING_ADAPTER_ALLOW_PRIVATE=true

# Web 前端（nginx 静态站）在宿主机上的端口。
# 默认 8088 而不是 8080：8080 太容易被本机其他服务占用，Docker 的端口转发
# 在冲突时会**静默失效**（`docker port` 显示映射存在、容器内 nginx 正常，
# 但宿主连接被拒），排查成本很高。
DDP_WEB_PORT=8088

# ===== 本地真实 Adapter（services/local-adapter）=====
# 该服务真实读取 MinIO 导出产物、用 ffmpeg 抽帧、训练/推理/评测并回签 HMAC 回调。
# 说明见 services/local-adapter/README.md。
DDP_LOCAL_ADAPTER_PORT=9100
LOCAL_ADAPTER_PUBLIC_BASE_URL=http://localhost:9100
LOCAL_ADAPTER_TRAINING_ADAPTER_ID=local-training
LOCAL_ADAPTER_TRAINING_ADAPTER_VERSION=1.0.0
LOCAL_ADAPTER_MODEL_ADAPTER_ID=local-model
LOCAL_ADAPTER_MODEL_ADAPTER_VERSION=1.0.0
# 本地开发默认密钥（>=32 字符）；必须与下面 DDP_*_SHARED_SECRETS 完全一致。
LOCAL_ADAPTER_TRAINING_SECRET=local-training-dev-secret-0123456789abcdef
LOCAL_ADAPTER_MODEL_SECRET=local-model-dev-secret-0123456789abcdef
LOCAL_ADAPTER_FRAMES_PER_VIDEO=8
LOCAL_ADAPTER_IMAGE_SIZE=32
LOCAL_ADAPTER_MAX_CONCURRENT_RUNS=2
LOCAL_ADAPTER_MAX_PENDING_RUNS=32
LOCAL_ADAPTER_EXPORT_PREFIX=exports
LOCAL_ADAPTER_MODEL_PREFIX=models
LOCAL_ADAPTER_EVALUATION_PREFIX=evaluations
LOCAL_ADAPTER_INFERENCE_PREFIX=inference
LOCAL_ADAPTER_ALLOW_SINGLE_MODEL_FALLBACK=true
# DDP 出站网关指向 compose 网络内的服务名。直接在宿主机运行 backend 时，
# 改成 http://127.0.0.1:9100。未登记 endpoint 的 adapter 仍返回 503。
DDP_TRAINING_ADAPTER_ENDPOINTS={"local-training":"http://local-adapter:9100"}
DDP_MODEL_ADAPTER_ENDPOINTS={"local-model":"http://local-adapter:9100"}
DDP_TRAINING_ADAPTER_SHARED_SECRETS={"local-training":"local-training-dev-secret-0123456789abcdef"}
DDP_TRAINING_ADAPTER_CAPABILITIES={"local-training":["submit","status","cancel","callback","model_ref"]}
DDP_MODEL_ADAPTER_SHARED_SECRETS={"local-model":"local-model-dev-secret-0123456789abcdef"}
DDP_MODEL_ADAPTER_CAPABILITIES={"local-model":["evaluate","inference","callback","status","cancel"]}
