# 复制为 .env 后按需修改；.env 不入库。
DDP_ENV=local
DDP_APP_NAME=DDP
DDP_APP_VERSION=0.1.0
DDP_LOG_LEVEL=INFO

# 对外元信息 GET /api/v1/platform/meta 的 phase/modules 由配置声明，不在路由里硬编码。
DDP_PLATFORM_PHASE=7

DDP_DATABASE_URL=postgresql+psycopg://ddp:ddp@localhost:5432/ddp
DDP_S3_ENDPOINT=http://localhost:9000
DDP_S3_ACCESS_KEY=minioadmin
DDP_S3_SECRET_KEY=minioadmin
DDP_S3_BUCKET=ddp-raw
DDP_S3_REGION=us-east-1

# 本地开发用；生产必须由环境注入强随机值（至少 32 个字符，且不能是占位符）。
# 非 local 环境若 JWT 配置不完整，应用启动自检会直接拒绝启动。
DDP_JWT_SECRET=replace-me-in-production
DDP_JWT_ISSUER=ddp
DDP_JWT_AUDIENCE=ddp-api
# 校验 exp/nbf 时允许的时钟偏差（秒）。
DDP_JWT_LEEWAY_SECONDS=30
# 令牌有效期策略（分钟）；不参与令牌校验，校验以 token 内 exp 为准。
DDP_JWT_EXPIRE_MINUTES=720

# 仅本地测试/loopback 使用的 Header 认证后门；默认关闭。
# 非 local 环境即使设为 true 也会被启动自检拒绝。
DDP_LOCAL_HEADER_AUTH=false
