{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ddp.local/schemas/annotation/iaa-report.v1.schema.json",
  "title": "IAAReportOut",
  "description": "由后端实际响应模型 IAAReportOut 生成；字段与 packages/contracts/openapi.yaml 阶段 3 实现快照一致。",
  "x-ddp-contract-version": "ddp.stage3/1.0.0",
  "x-ddp-status": "FROZEN",
  "properties": {
    "report_id": {
      "format": "uuid",
      "title": "Report Id",
      "type": "string"
    },
    "project_id": {
      "format": "uuid",
      "title": "Project Id",
      "type": "string"
    },
    "task_id": {
      "format": "uuid",
      "title": "Task Id",
      "type": "string"
    },
    "schema_id": {
      "format": "uuid",
      "title": "Schema Id",
      "type": "string"
    },
    "schema_version": {
      "title": "Schema Version",
      "type": "integer"
    },
    "status": {
      "title": "Status",
      "type": "string"
    },
    "metric_definitions_version": {
      "title": "Metric Definitions Version",
      "type": "string"
    },
    "sample_item_count": {
      "title": "Sample Item Count",
      "type": "integer"
    },
    "overlap_item_count": {
      "title": "Overlap Item Count",
      "type": "integer"
    },
    "annotator_count": {
      "title": "Annotator Count",
      "type": "integer"
    },
    "metrics": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Metrics",
      "type": "array"
    },
    "excluded_items": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Excluded Items",
      "type": "array"
    },
    "computed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Computed At"
    },
    "version": {
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "report_id",
    "project_id",
    "task_id",
    "schema_id",
    "schema_version",
    "status",
    "metric_definitions_version",
    "sample_item_count",
    "overlap_item_count",
    "annotator_count",
    "metrics",
    "excluded_items",
    "computed_at",
    "version"
  ],
  "type": "object",
  "additionalProperties": false
}
