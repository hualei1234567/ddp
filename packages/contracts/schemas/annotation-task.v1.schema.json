    "project_id",
    "code",
    "name",
    "description",
    "sample_set_id",
    "schema_id",
    "schema_version",
    "schema_sha256",
    "status",
    "allowed_actions",
    "target_item_count",
    "target_episode_count",
    "priority",
    "assignment_mode",
    "iaa_policy",
    "quality_policy",
    "progress",
    "quality_summary",
    "due_at",
    "is_overdue",
    "accepted_at",
    "completed_at",
    "gold_set_id",
    "iaa_report_id",
    "status_reason",
    "blocked_reason",
    "version",
    "created_at",
    "updated_at",
    "created_by",
