{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ddp.local/schemas/annotation/annotation-task.v1.schema.json",
  "title": "AnnotationTaskOut",
  "description": "由后端实际响应模型 AnnotationTaskOut 生成；字段与 packages/contracts/openapi.yaml 阶段 3 实现快照一致。",
  "x-ddp-contract-version": "ddp.stage3/1.0.0",
  "x-ddp-status": "FROZEN",
  "properties": {
    "task_id": {
      "format": "uuid",
      "title": "Task Id",
      "type": "string"
    },
    "project_id": {
      "format": "uuid",
      "title": "Project Id",
      "type": "string"
    },
    "code": {
      "title": "Code",
      "type": "string"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "description": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Description"
    },
    "sample_set_id": {
      "format": "uuid",
      "title": "Sample Set Id",
      "type": "string"
    },
    "schema_id": {
      "format": "uuid",
      "title": "Schema Id",
      "type": "string"
    },
    "schema_version": {
      "title": "Schema Version",
      "type": "integer"
    },
    "schema_sha256": {
      "title": "Schema Sha256",
      "type": "string"
    },
    "status": {
      "title": "Status",
      "type": "string"
    },
    "allowed_actions": {
      "items": {
        "type": "string"
      },
      "title": "Allowed Actions",
      "type": "array"
    },
    "target_item_count": {
      "title": "Target Item Count",
      "type": "integer"
    },
    "target_episode_count": {
      "title": "Target Episode Count",
      "type": "integer"
    },
    "priority": {
      "title": "Priority",
      "type": "string"
    },
    "assignment_mode": {
      "title": "Assignment Mode",
      "type": "string"
    },
    "review_mode": {
      "title": "Review Mode",
      "type": "string"
    },
    "iaa_policy": {
      "additionalProperties": true,
      "title": "Iaa Policy",
      "type": "object"
    },
    "quality_policy": {
      "additionalProperties": true,
      "title": "Quality Policy",
      "type": "object"
    },
    "required_skills": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AnnotationSkillTag"
      },
      "description": "技能路由配置（V52-009）。空数组 = 不启用技能路由，分配行为与未配置一致。服务端始终回显该字段（对客户端可视为必回显；契约暂不声明 required 以保持与 1.36.0 基线的响应兼容，版本随主控统一 bump 1.40.0 时收敛）。创建/PATCH 通过请求体传入。"
    },
    "progress": {
      "additionalProperties": true,
      "title": "Progress",
      "type": "object"
    },
    "quality_summary": {
      "additionalProperties": true,
      "title": "Quality Summary",
      "type": "object"
    },
    "due_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Due At"
    },
    "is_overdue": {
      "title": "Is Overdue",
      "description": "派生事实：截止时间已过且任务未进入终态（完成/取消/归档）。",
      "type": "boolean"
    },
    "accepted_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Accepted At"
    },
    "completed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Completed At"
    },
    "gold_set_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Gold Set Id"
    },
    "iaa_report_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Iaa Report Id"
    },
    "status_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Status Reason"
    },
    "blocked_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Blocked Reason"
    },
    "version": {
      "title": "Version",
      "type": "integer"
    },
    "created_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Created At"
    },
    "updated_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Updated At"
    },
    "created_by": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Created By"
    },
    "updated_by": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Updated By"
    }
  },
  "required": [
    "task_id",
    "project_id",
    "code",
    "name",
    "description",
    "sample_set_id",
    "schema_id",
    "schema_version",
    "schema_sha256",
    "status",
    "allowed_actions",
    "target_item_count",
    "target_episode_count",
    "priority",
    "assignment_mode",
    "review_mode",
    "iaa_policy",
    "quality_policy",
    "progress",
    "quality_summary",
    "due_at",
    "is_overdue",
    "accepted_at",
    "completed_at",
    "gold_set_id",
    "iaa_report_id",
    "status_reason",
    "blocked_reason",
    "version",
    "created_at",
    "updated_at",
    "created_by",
    "updated_by"
  ],
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "AnnotationSkillTag": {
      "type": "object",
      "required": [
        "tag_name"
      ],
      "additionalProperties": false,
      "properties": {
        "tag_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "规范化技能标签名（服务端统一小写、去首尾空白后比对）"
        },
        "category": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64
        },
        "weight": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "default": 1.0,
          "description": "可选技能加权评分权重；必配技能不使用"
        },
        "required": {
          "type": "boolean",
          "default": true,
          "description": "true=必配技能（缺任一即排除候选）；false=可选技能（参与加权评分）"
        }
      }
    }
  },
  "x-ddp-note": "V52-009：required_skills 为增量字段；契约版本待主控统一 bump 1.40.0。"
}
