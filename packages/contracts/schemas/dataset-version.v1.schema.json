{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ddp.local/schemas/dataset/dataset-version.v1.schema.json",
  "title": "DDP DatasetVersion v1（阶段 4 草案）",
  "description": "一次可复现的样本清单与划分快照。FROZEN 后样本、划分、Manifest、质量报告、泄漏报告与 Hash 不可原地修改；任何变化创建新 dataset_version。",
  "$comment": "契约版本：ddp.stage4/1.0.0-draft",
  "type": "object",
  "required": [
    "dataset_version_id",
    "project_id",
    "dataset_id",
    "dataset_lineage_id",
    "dataset_version",
    "status",
    "validity_status",
    "selection_rule_version",
    "selection_filters",
    "selection_snapshot_at",
    "dedup_policy_ref",
    "split_policy_ref",
    "leakage_policy_ref",
    "quality_policy_ref",
    "candidate_count",
    "selected_count",
    "excluded_count",
    "duplicated_count",
    "item_count",
    "train_count",
    "validation_count",
    "test_count",
    "build_attempt",
    "version",
    "created_at",
    "updated_at",
    "created_by"
  ],
  "additionalProperties": false,
  "properties": {
    "dataset_version_id": {"$ref": "#/$defs/uuid"},
    "project_id": {"$ref": "#/$defs/uuid"},
    "dataset_id": {"$ref": "#/$defs/uuid"},
    "dataset_lineage_id": {"$ref": "#/$defs/uuid"},
    "dataset_version": {"type": "integer", "minimum": 1, "description": "同一 dataset_lineage_id 内单调递增且不复用。"},
    "status": {
      "type": "string",
      "enum": ["DRAFT", "BUILDING", "VALIDATING", "READY", "FROZEN", "SUPERSEDED", "VALIDATION_FAILED", "CANCELLED", "ARCHIVED"]
    },
    "validity_status": {
      "type": "string",
      "enum": ["VALID", "STALE", "INVALIDATED", "UNKNOWN"],
      "description": "与生命周期状态分离；上游失效或 Hash 变化时置 STALE/INVALIDATED，不静默改写内容。"
    },
    "selection_rule_version": {"type": "string", "minLength": 1, "maxLength": 64},
    "selection_filters": {"type": "object", "additionalProperties": true},
    "selection_snapshot_at": {"$ref": "#/$defs/date_time"},
    "dedup_policy_ref": {"$ref": "#/$defs/policy_ref"},
    "split_policy_ref": {"$ref": "#/$defs/policy_ref"},
    "leakage_policy_ref": {"$ref": "#/$defs/policy_ref"},
    "quality_policy_ref": {"$ref": "#/$defs/policy_ref"},
    "candidate_count": {"type": "integer", "minimum": 0},
    "selected_count": {"type": "integer", "minimum": 0},
    "excluded_count": {"type": "integer", "minimum": 0},
    "duplicated_count": {"type": "integer", "minimum": 0},
    "item_count": {"type": "integer", "minimum": 0},
    "train_count": {"type": "integer", "minimum": 0},
    "validation_count": {"type": "integer", "minimum": 0},
    "test_count": {"type": "integer", "minimum": 0},
    "total_duration_ns": {"type": ["integer", "null"], "minimum": 0},
    "total_bytes": {"type": ["integer", "null"], "minimum": 0},
    "episode_version_digest": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "annotation_schema_versions": {"type": "array", "items": {"$ref": "#/$defs/schema_snapshot"}, "uniqueItems": true},
    "annotation_submission_refs_digest": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "manifest_key": {"type": ["string", "null"], "maxLength": 1024},
    "manifest_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "quality_report_id": {"oneOf": [{"$ref": "#/$defs/uuid"}, {"type": "null"}]},
    "quality_report_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "leakage_report_id": {"oneOf": [{"$ref": "#/$defs/uuid"}, {"type": "null"}]},
    "leakage_report_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "leakage_status": {"type": ["string", "null"], "enum": ["PASS", "WARN", "FAIL", "UNKNOWN", "WAIVED", null]},
    "source_snapshot_at": {"oneOf": [{"$ref": "#/$defs/date_time"}, {"type": "null"}]},
    "build_attempt": {"type": "integer", "minimum": 0},
    "freeze_approval_id": {"oneOf": [{"$ref": "#/$defs/uuid"}, {"type": "null"}]},
    "frozen_by": {"oneOf": [{"$ref": "#/$defs/uuid"}, {"type": "null"}]},
    "frozen_at": {"oneOf": [{"$ref": "#/$defs/date_time"}, {"type": "null"}]},
    "supersedes_version_id": {"oneOf": [{"$ref": "#/$defs/uuid"}, {"type": "null"}]},
    "superseded_by_version_id": {"oneOf": [{"$ref": "#/$defs/uuid"}, {"type": "null"}]},
    "archived_at": {"oneOf": [{"$ref": "#/$defs/date_time"}, {"type": "null"}]},
    "archive_reason": {"type": ["string", "null"], "maxLength": 2000},
    "blocking_issues": {"type": "array", "items": {"type": "string", "maxLength": 500}, "uniqueItems": true},
    "warnings": {"type": "array", "items": {"type": "string", "maxLength": 500}, "uniqueItems": true},
    "allowed_actions": {"type": "array", "items": {"type": "string", "maxLength": 64}, "uniqueItems": true},
    "version": {"type": "integer", "minimum": 1},
    "created_at": {"$ref": "#/$defs/date_time"},
    "updated_at": {"$ref": "#/$defs/date_time"},
    "created_by": {"$ref": "#/$defs/uuid"},
    "updated_by": {"$ref": "#/$defs/uuid"}
  },
  "$defs": {
    "uuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "date_time": {"type": "string", "format": "date-time"},
    "policy_ref": {
      "type": "object",
      "required": ["policy_id", "version", "policy_sha256"],
      "additionalProperties": false,
      "properties": {
        "policy_id": {"$ref": "#/$defs/uuid"},
        "version": {"type": "integer", "minimum": 1},
        "policy_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "schema_snapshot": {
      "type": "object",
      "required": ["schema_id", "schema_version", "schema_sha256"],
      "additionalProperties": false,
      "properties": {
        "schema_id": {"$ref": "#/$defs/uuid"},
        "schema_version": {"type": "integer", "minimum": 1},
        "schema_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
