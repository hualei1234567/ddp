{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ddp.local/schemas/annotation/gold-set.v1.schema.json",
  "title": "GoldSetOut",
  "description": "脱敏黄金集视图：items 内不含 expected_labels。",
  "x-ddp-contract-version": "ddp.stage3/1.0.0",
  "x-ddp-status": "FROZEN",
  "properties": {
