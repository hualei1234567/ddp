{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ddp.local/schemas/dataset/external-training-reference.v1.schema.json",
  "title": "DDP ExternalTrainingReference v1（阶段 4 草案）",
  "description": "外部训练平台任务/模型/评测引用。DDP 只保存引用与状态摘要，不复制权重、不托管训练日志大文件、不伪造训练结果。DDP 不建设训练集群。",
  "$comment": "契约版本：ddp.stage4/1.0.0-draft",
  "type": "object",
  "required": [
    "external_ref_id",
    "project_id",
    "adapter_id",
    "adapter_version",
    "training_delivery_id",
    "training_request_revision_id",
    "dataset_version_id",
    "external_run_id",
    "external_status",
    "execution_mode",
    "correlation_id",
    "idempotency_key",
    "submitted_at",
    "last_synced_at",
    "version"
  ],
  "additionalProperties": false,
  "properties": {
    "external_ref_id": {"$ref": "#/$defs/uuid"},
    "project_id": {"$ref": "#/$defs/uuid"},
    "adapter_id": {"type": "string", "minLength": 1, "maxLength": 100},
    "adapter_version": {"type": "string", "minLength": 1, "maxLength": 100},
    "training_delivery_id": {"$ref": "#/$defs/uuid"},
    "training_request_revision_id": {"$ref": "#/$defs/uuid"},
    "dataset_version_id": {"$ref": "#/$defs/uuid"},
    "external_run_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "external_run_url": {"type": ["string", "null"], "maxLength": 4096},
    "external_status": {"type": "string", "enum": ["SUBMITTED", "RUNNING", "SUCCEEDED", "FAILED", "CANCELLED", "UNKNOWN", "UNAVAILABLE", "DRY_RUN"], "description": "DRY_RUN 是演练专用终态：只做校验与计划，不是成功训练，读取方不得按 SUCCEEDED 判定。"},
    "execution_mode": {
      "type": "string",
      "enum": ["LOCAL", "MOCK", "DRY_RUN", "REMOTE", "UNKNOWN"],
      "description": "训练执行方式，提交时定死、之后不可修改。LOCAL=本机参考实现真实执行；MOCK=模拟；DRY_RUN=只走编排不训练；REMOTE=真实远端平台；UNKNOWN=迁移前记录，无法回溯判定。读取方不得把 MOCK/DRY_RUN/UNKNOWN 当作真实训练结果。"
    },
    "status_stale": {"type": "boolean", "default": false, "description": "状态超过同步窗口或平台不可达时为 true，不得显示成功。"},
    "submitted_at": {"$ref": "#/$defs/date_time"},
    "last_synced_at": {"$ref": "#/$defs/date_time"},
    "model_ref": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "model_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "model_version": {"type": ["string", "null"], "maxLength": 100},
        "registered_at": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "evaluation_ref": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "evaluation_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "evaluation_version": {"type": ["string", "null"], "maxLength": 100},
        "registered_at": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "artifacts": {
      "type": ["object", "null"],
      "additionalProperties": true,
      "description": "适配器回调回传的产物元数据（如 model/metadata 的 object_key、sha256、size_bytes）。用于在平台内登记模型版本；DDP 只存元数据，不复制权重。MOCK 执行的产物带 mock=true 且不含可登记的对象键，下游必须拒绝。"
    },
    "dry_run_plan": {
      "type": ["object", "null"],
      "additionalProperties": true,
      "description": "演练计划，仅 execution_mode=DRY_RUN 时非空：包含校验结论与将执行的动作清单，不包含任何训练产物；不得渲染成训练结果。"
    },
    "config_summary": {
      "type": ["object", "null"],
      "additionalProperties": true,
      "description": "提交训练时的配置摘要：服务端在落库前裁剪到 ≤8KiB，并把密钥/凭据/绝对路径替换为占位符。null 只表示迁移 0063 之前的存量记录未保存配置，不等于提交时没有配置（后者是空对象）。"
    },
    "code_version": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 100,
      "description": "训练代码/镜像版本标识，由发起方在提交时声明；未知为 null，服务端不推断，提交后不可修改。"
    },
    "model_version": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 100,
      "description": "本次 run 的模型版本标识，由发起方在提交时声明；未知为 null，服务端不推断，提交后不可修改。"
    },
    "correlation_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "idempotency_key": {"type": "string", "minLength": 8, "maxLength": 128},
    "error_code": {"type": ["string", "null"], "maxLength": 100},
    "error_summary": {"type": ["string", "null"], "maxLength": 2000},
    "allowed_actions": {"type": "array", "items": {"type": "string", "maxLength": 64}, "uniqueItems": true},
    "version": {"type": "integer", "minimum": 1},
    "created_at": {"$ref": "#/$defs/date_time"},
    "updated_at": {"$ref": "#/$defs/date_time"}
  },
  "$defs": {
    "uuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "date_time": {"type": "string", "format": "date-time"}
  }
}
