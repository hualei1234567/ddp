  "title": "DDP 阶段 4 数据集与训练错误码注册表 v1（草案）",
  "description": "阶段 4 HTTP 与 Job/领域错误码。客户端必须按 code 分支；未知 code 不得默认成功。HTTP 状态码与可重试性为契约。阶段 2/3 通用错误码可复用，本表只列阶段 4 新增或特别说明的语义。阶段 4 当前无实现，所有阶段 4 错误码 implemented=false，不得据此声称可用。",
  "version": "ddp.stage4/1.0.0-draft",
  "status": "DRAFT",
  "frozen_at": null,
  "implementation_alignment": {
    "source_of_truth": "backend/app/api/errors.py（阶段 4 尚无对应实现）",
    "implementation_baseline": "main@659fe2b；未发现阶段 4 Dataset/DatasetVersion/ExportJob/TrainingRequest 领域模块、路由或迁移",
    "note": "全部阶段 4 错误码为预留设计；实现落地时必须以 backend/app/api/errors.py 与领域错误映射校正 HTTP 状态，并同步本表。",
    "all_stage4_codes_implemented": false
  },
  "envelope": {
    "required": [
      "error"
    ],
    "properties": {
      "error": {
        "required": [
          "code",
          "message"
        ],
        "optional": [
          "request_id",
          "details"
        ],
        "details_rule": "可选字段级错误、item_refs、episode_ids、expected/actual、counts、violation_refs；不得包含对象存储凭据、Token、Secret、跨项目对象名称或存在性信息"
      }
    }
  },
