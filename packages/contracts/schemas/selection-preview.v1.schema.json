{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ddp.local/schemas/dataset/selection-preview.v1.schema.json",
  "title": "DDP Dataset SelectionPreview v1（阶段 4 草案）",
  "description": "数据集选择预览。只读预演，不冻结版本；展示候选、入选、排除、重复、划分与门禁结果。数据不足或空测试集必须显式失败，不得静默成功。",
  "$comment": "契约版本：ddp.stage4/1.0.0-draft",
  "type": "object",
  "required": [
    "project_id",
    "dataset_id",
    "candidate_count",
    "selected_count",
    "excluded_count",
    "duplicated_count",
    "split_counts",
    "split_preview_status",
    "exclusion_summary",
    "warnings",
    "blocking_issues",
    "source_snapshot_at",
    "preview_sha256"
  ],
  "additionalProperties": false,
  "properties": {
    "preview_id": {"oneOf": [{"$ref": "#/$defs/uuid"}, {"type": "null"}], "description": "落库预览时返回；纯预演为 null。"},
    "project_id": {"$ref": "#/$defs/uuid"},
    "dataset_id": {"$ref": "#/$defs/uuid"},
    "dataset_version_id": {"oneOf": [{"$ref": "#/$defs/uuid"}, {"type": "null"}]},
    "candidate_count": {"type": "integer", "minimum": 0},
    "selected_count": {"type": "integer", "minimum": 0},
    "excluded_count": {"type": "integer", "minimum": 0},
    "duplicated_count": {"type": "integer", "minimum": 0},
    "split_counts": {"$ref": "#/$defs/split_counts"},
    "split_preview_status": {"type": "string", "enum": ["OK", "INSUFFICIENT_DATA", "EMPTY_TEST_SPLIT", "INVALID"]},
    "exclusion_summary": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "count"],
        "additionalProperties": false,
        "properties": {
          "code": {"type": "string", "maxLength": 100},
          "count": {"type": "integer", "minimum": 0},
          "sample_episode_ids": {"type": "array", "items": {"$ref": "#/$defs/uuid"}, "uniqueItems": true}
        }
      }
    },
    "items_sample": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": ["episode_id", "episode_version", "split", "decision"],
        "additionalProperties": false,
        "properties": {
          "episode_id": {"$ref": "#/$defs/uuid"},
          "episode_version": {"type": "integer", "minimum": 1},
          "split": {"type": ["string", "null"], "enum": ["TRAIN", "VALIDATION", "TEST", null]},
          "decision": {"type": "string", "enum": ["SELECTED", "EXCLUDED", "DUPLICATED"]},
          "reason": {"type": ["string", "null"], "maxLength": 500}
        }
      }
    },
    "warnings": {"type": "array", "items": {"type": "string", "maxLength": 500}, "uniqueItems": true},
    "blocking_issues": {"type": "array", "items": {"type": "string", "maxLength": 500}, "uniqueItems": true},
    "source_snapshot_at": {"$ref": "#/$defs/date_time"},
    "preview_sha256": {"$ref": "#/$defs/sha256"},
    "created_at": {"$ref": "#/$defs/date_time"}
  },
  "$defs": {
    "uuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "date_time": {"type": "string", "format": "date-time"},
    "split_counts": {
      "type": "object",
      "required": ["train", "validation", "test"],
      "additionalProperties": false,
      "properties": {
        "train": {"type": "integer", "minimum": 0},
        "validation": {"type": "integer", "minimum": 0},
        "test": {"type": "integer", "minimum": 0}
      }
    }
  }
}
