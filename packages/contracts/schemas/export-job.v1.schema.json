{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ddp.local/schemas/dataset/export-job.v1.schema.json",
  "title": "DDP ExportJob v1（阶段 4 草案）",
  "description": "异步导出任务。只有 FROZEN 且 validity_status 有效的 DatasetVersion 可导出；PARTIAL 不是成功；重试不得静默覆盖成功产物。LeRobot P0 在真实 Loader 验证前 verification_status 固定 UNVERIFIED。",
  "$comment": "契约版本：ddp.stage4/1.0.0-draft",
  "type": "object",
  "required": [
    "export_job_id",
    "project_id",
    "dataset_version_id",
    "status",
    "format",
    "format_version",
    "exporter_id",
    "exporter_version",
    "mapping_version",
    "config_sha256",
    "idempotency_key",
    "requested_by",
    "output_prefix",
    "attempt",
    "max_attempts",
    "timeout_seconds",
    "verification_status",
    "version",
    "created_at",
    "updated_at"
  ],
  "additionalProperties": false,
  "properties": {
    "export_job_id": {"$ref": "#/$defs/uuid"},
    "project_id": {"$ref": "#/$defs/uuid"},
    "dataset_version_id": {"$ref": "#/$defs/uuid"},
    "status": {"type": "string", "enum": ["QUEUED", "RUNNING", "SUCCEEDED", "FAILED", "PARTIAL", "CANCELLED"]},
    "format": {"type": "string", "enum": ["LE_ROBOT", "CANONICAL"], "x-extensible-enum": ["LE_ROBOT", "CANONICAL"], "description": "LE_ROBOT 是 LeRobot 元数据 profile（帧级映射未实现，verification_status 固定 UNVERIFIED）；CANONICAL 是平台规范格式。取值集合可增长，客户端必须容忍未知格式并回退到不支持；其他格式必须显式返回 export_format_unsupported。"},
    "format_version": {"type": "string", "enum": ["ddp.lerobot/1.0.0", "ddp.canonical/1.0.0"], "x-extensible-enum": ["ddp.lerobot/1.0.0", "ddp.canonical/1.0.0"], "description": "格式与版本必须成对：LE_ROBOT ↔ ddp.lerobot/1.0.0，CANONICAL ↔ ddp.canonical/1.0.0。交叉组合返回 export_format_version_unsupported。取值集合可增长，客户端必须容忍未知版本。"},
    "exporter_id": {"type": "string", "minLength": 1, "maxLength": 100},
    "exporter_version": {"type": "string", "minLength": 1, "maxLength": 100},
    "mapping_version": {"type": "string", "minLength": 1, "maxLength": 100},
    "config": {"type": "object", "additionalProperties": true},
    "config_sha256": {"$ref": "#/$defs/sha256"},
    "idempotency_key": {"type": "string", "minLength": 8, "maxLength": 128},
    "requested_by": {"$ref": "#/$defs/uuid"},
    "output_prefix": {"type": "string", "minLength": 1, "maxLength": 1024},
    "artifact_count": {"type": ["integer", "null"], "minimum": 0},
    "total_bytes": {"type": ["integer", "null"], "minimum": 0},
    "artifact_manifest_key": {"type": ["string", "null"], "maxLength": 1024},
    "artifact_manifest_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "aggregate_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "attempt": {"type": "integer", "minimum": 0},
    "max_attempts": {"type": "integer", "minimum": 1},
    "timeout_seconds": {"type": "integer", "minimum": 1},
    "started_at": {"oneOf": [{"$ref": "#/$defs/date_time"}, {"type": "null"}]},
    "finished_at": {"oneOf": [{"$ref": "#/$defs/date_time"}, {"type": "null"}]},
    "cancel_requested_at": {"oneOf": [{"$ref": "#/$defs/date_time"}, {"type": "null"}]},
    "error_code": {"type": ["string", "null"], "maxLength": 100},
    "error_summary": {"type": ["string", "null"], "maxLength": 2000},
    "log_ref": {"type": ["string", "null"], "maxLength": 1024},
    "verification_status": {
      "type": "string",
      "enum": ["UNVERIFIED", "VERIFIED_BY_LOADER"],
      "description": "在真实 LeRobot Loader 验证前必须为 UNVERIFIED；不得宣称已兼容。"
    },
    "verification_evidence_ref": {"type": ["string", "null"], "maxLength": 1024},
    "allowed_actions": {"type": "array", "items": {"type": "string", "maxLength": 64}, "uniqueItems": true},
    "version": {"type": "integer", "minimum": 1},
    "created_at": {"$ref": "#/$defs/date_time"},
    "updated_at": {"$ref": "#/$defs/date_time"}
  },
  "$defs": {
    "uuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "date_time": {"type": "string", "format": "date-time"}
  }
}
