{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ddp.local/schemas/dataset/training-request-revision.v1.schema.json",
  "title": "DDP TrainingRequestRevision v1（阶段 4 草案）",
  "description": "TrainingRequest 的不可变需求快照。批准后内容不可原地修改；变更创建新 revision，revision_no 递增并重新审批。",
  "$comment": "契约版本：ddp.stage4/1.0.0-draft",
  "type": "object",
  "required": [
    "revision_id",
    "training_request_id",
    "project_id",
    "revision_no",
    "status",
    "snapshot",
    "revision_sha256",
    "created_at",
    "created_by"
  ],
  "additionalProperties": false,
  "properties": {
    "revision_id": {"$ref": "#/$defs/uuid"},
    "training_request_id": {"$ref": "#/$defs/uuid"},
    "project_id": {"$ref": "#/$defs/uuid"},
    "revision_no": {"type": "integer", "minimum": 1},
    "status": {"type": "string", "enum": ["DRAFT", "SUBMITTED", "PENDING_REVIEW", "APPROVED", "REJECTED", "SUPERSEDED"]},
    "snapshot": {"$ref": "#/$defs/requirement_snapshot"},
    "change_reason": {"type": ["string", "null"], "maxLength": 2000},
    "supersedes_revision_id": {"oneOf": [{"$ref": "#/$defs/uuid"}, {"type": "null"}]},
    "submitted_by": {"oneOf": [{"$ref": "#/$defs/uuid"}, {"type": "null"}]},
    "submitted_at": {"oneOf": [{"$ref": "#/$defs/date_time"}, {"type": "null"}]},
    "reviewed_by": {"oneOf": [{"$ref": "#/$defs/uuid"}, {"type": "null"}]},
    "reviewed_at": {"oneOf": [{"$ref": "#/$defs/date_time"}, {"type": "null"}]},
    "approved_by": {"oneOf": [{"$ref": "#/$defs/uuid"}, {"type": "null"}]},
    "approved_at": {"oneOf": [{"$ref": "#/$defs/date_time"}, {"type": "null"}]},
    "rejected_by": {"oneOf": [{"$ref": "#/$defs/uuid"}, {"type": "null"}]},
    "rejected_at": {"oneOf": [{"$ref": "#/$defs/date_time"}, {"type": "null"}]},
    "rejection_reason": {"type": ["string", "null"], "maxLength": 2000},
    "revision_sha256": {"$ref": "#/$defs/sha256"},
    "created_at": {"$ref": "#/$defs/date_time"},
    "created_by": {"$ref": "#/$defs/uuid"}
  },
  "$defs": {
    "uuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "date_time": {"type": "string", "format": "date-time"},
    "requirement_snapshot": {
      "type": "object",
      "required": [
        "business_goal",
        "model_type",
        "training_type",
        "data_modalities",
        "scene_targets",
        "action_targets",
        "robot_targets",
        "device_targets",
        "required_labels",
        "required_schema_versions",
        "target_episode_count",
        "target_duration_ns",
        "quality_thresholds",
        "split_requirements",
        "format",
        "format_version",
        "delivery_due_at",
        "acceptance_method",
        "priority"
      ],
      "additionalProperties": false,
      "properties": {
        "business_goal": {"type": "string", "minLength": 1, "maxLength": 2000},
        "model_type": {"type": "string", "minLength": 1, "maxLength": 100},
        "training_type": {"type": "string", "enum": ["SUPERVISED", "IMITATION", "RL", "FINE_TUNE", "OTHER"]},
        "data_modalities": {"type": "array", "minItems": 1, "items": {"type": "string", "maxLength": 64}, "uniqueItems": true},
        "scene_targets": {"type": "array", "items": {"type": "string", "maxLength": 100}, "uniqueItems": true},
        "action_targets": {"type": "array", "items": {"type": "string", "maxLength": 100}, "uniqueItems": true},
        "robot_targets": {"type": "array", "items": {"type": "string", "maxLength": 100}, "uniqueItems": true},
        "device_targets": {"type": "array", "items": {"type": "string", "maxLength": 100}, "uniqueItems": true},
        "required_labels": {"type": "array", "items": {"type": "string", "maxLength": 100}, "uniqueItems": true},
        "required_schema_versions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["schema_id", "schema_version"],
            "additionalProperties": false,
            "properties": {
              "schema_id": {"$ref": "#/$defs/uuid"},
              "schema_version": {"type": "integer", "minimum": 1}
            }
          }
        },
        "target_episode_count": {"type": ["integer", "null"], "minimum": 1},
        "target_duration_ns": {"type": ["integer", "null"], "minimum": 1},
        "quality_thresholds": {"type": "object", "additionalProperties": true},
        "split_requirements": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "train_ratio": {"type": "number", "minimum": 0, "maximum": 1},
            "validation_ratio": {"type": "number", "minimum": 0, "maximum": 1},
            "test_ratio": {"type": "number", "minimum": 0, "maximum": 1},
            "group_by": {"type": "array", "items": {"type": "string", "maxLength": 100}, "uniqueItems": true}
          }
        },
        "leakage_policy_id": {"oneOf": [{"$ref": "#/$defs/uuid"}, {"type": "null"}]},
        "format": {"type": "string", "enum": ["LE_ROBOT"]},
        "format_version": {"type": "string", "const": "ddp.lerobot/1.0.0"},
        "delivery_due_at": {"$ref": "#/$defs/date_time"},
        "acceptance_method": {"type": "string", "minLength": 1, "maxLength": 500},
        "priority": {"type": "string", "enum": ["P0", "P1", "P2", "P3"]}
      }
    }
  }
}
