        "episode_lineage_id": {
          "format": "uuid",
          "title": "Episode Lineage Id",
          "type": "string"
        },
        "episode_version": {
          "title": "Episode Version",
          "type": "integer"
        },
        "sample_role": {
          "title": "Sample Role",
          "type": "string"
        },
        "selected_reason": {
          "title": "Selected Reason",
          "type": "string"
        },
        "stratum": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Stratum"
        },
        "time_domain": {
          "title": "Time Domain",
          "type": "string"
        },
        "start_time_ns": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Time Ns"
        },
        "end_time_ns": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Time Ns"
        }
      },
      "required": [
        "episode_id",
        "episode_lineage_id",
        "episode_version",
        "sample_role",
        "selected_reason",
        "stratum",
        "time_domain"
