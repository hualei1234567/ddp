    "status": {
      "title": "Status",
      "type": "string"
    },
    "selection_rule_version": {
      "title": "Selection Rule Version",
      "type": "string"
    },
    "strategy": {
      "title": "Strategy",
      "type": "string"
    },
    "filters": {
