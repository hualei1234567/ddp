      "title": "Updated At"
    },
    "created_by": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Created By"
    },
    "updated_by": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Updated By"
    }
  },
  "required": [
    "sample_set_id",
    "project_id",
    "code",
    "name",
    "status",
    "selection_rule_version",
    "strategy",
    "filters",
    "strata",
    "episode_refs",
    "dedup_key",
    "candidate_count",
    "selected_count",
    "excluded_count",
    "deduplicated_count",
    "snapshot_sha256",
    "snapshot_at",
    "cancelled_reason",
    "data_source",
    "exclusion_summary",
    "version",
    "created_at",
    "updated_at",
    "created_by",
    "updated_by"
