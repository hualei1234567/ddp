    "dedup_key": {
      "title": "Dedup Key",
      "type": "string"
    },
    "candidate_count": {
      "title": "Candidate Count",
      "type": "integer"
    },
    "selected_count": {
      "title": "Selected Count",
      "type": "integer"
    },
    "excluded_count": {
      "title": "Excluded Count",
      "type": "integer"
    },
    "deduplicated_count": {
      "title": "Deduplicated Count",
      "type": "integer"
    },
    "snapshot_sha256": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Snapshot Sha256"
    },
    "snapshot_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
