{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ddp.local/schemas/modelops/error-codes.v1.json",
  "title": "DDP 阶段 5 模型闭环错误码注册表 v1（冻结）",
  "description": "阶段 5 HTTP 与领域错误码。客户端必须按 code 分支；未知 code 不得默认成功。阶段 5 已实现；implemented=true 表示服务端会返回该 code。",
  "version": "ddp.stage5/1.0.0",
  "status": "FROZEN",
  "frozen_at": "2026-11-09",
  "envelope": {
    "required": [
      "error"
    ],
    "properties": {
      "error": {
        "required": [
          "code",
          "message"
        ],
        "optional": [
          "request_id",
          "details"
        ]
      }
    }
  },
  "codes": [
    {
      "code": "validation_failed",
      "http": 422,
      "implemented": true,
      "message": "请求参数或领域规则校验失败"
    },
    {
      "code": "resource_not_found",
      "http": 404,
      "implemented": true,
      "message": "资源不存在或不属于当前项目"
    },
    {
      "code": "forbidden",
      "http": 403,
      "implemented": true,
      "message": "无权执行该操作"
    },
    {
      "code": "state_transition_invalid",
      "http": 409,
      "implemented": true,
      "message": "资源状态不允许该操作"
    },
    {
      "code": "version_conflict",
      "http": 409,
      "implemented": true,
      "message": "资源版本已变化，请重新读取后再试"
    },
    {
      "code": "precondition_required",
      "http": 428,
      "implemented": true,
      "message": "写动作缺少 If-Match"
    },
    {
      "code": "idempotency_key_reused",
      "http": 409,
      "implemented": true,
      "message": "同一幂等键对应不同请求体"
    },
    {
      "code": "duplicate_resource",
      "http": 409,
      "implemented": true,
      "message": "项目内业务编码或版本重复"
    },
    {
      "code": "model_not_active",
      "http": 409,
      "implemented": true,
      "message": "模型未激活或已归档"
    },
    {
      "code": "model_version_immutable",
      "http": 409,
      "implemented": true,
      "message": "已发布版本不可原地修改"
    },
    {
      "code": "model_version_in_use",
      "http": 409,
      "implemented": true,
      "message": "存在 ACTIVE 推理服务，版本不可归档"
    },
    {
      "code": "model_release_approval_forbidden",
      "http": 403,
      "implemented": true,
      "message": "发布人不得是版本唯一创建人"
