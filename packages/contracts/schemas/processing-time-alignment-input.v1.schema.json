{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ddp.local/schemas/processing/time-alignment-input.v1.schema.json",
  "title": "DDP Processing Time Alignment Input v1",
  "description": "TIME_ALIGNMENT 的逐组、逐流时间事实输入；纳秒使用规范十进制字符串以避免 JavaScript 精度损失。唯一性与 start < end 由领域解析器强制校验。",
  "type": "object",
  "required": ["schema_version", "time_unit", "groups"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "string", "const": "ddp.processing.time-alignment-input/1.0.0"},
    "time_unit": {"type": "string", "const": "ns"},
    "groups": {"type": "array", "items": {"$ref": "#/$defs/group"}}
  },
  "$defs": {
    "nanoseconds": {"type": "string", "minLength": 1, "maxLength": 20, "pattern": "^-?(0|[1-9][0-9]*)$"},
    "frame_rate": {
      "type": "object",
      "required": ["num", "den"],
      "additionalProperties": false,
      "properties": {
        "num": {"type": "integer", "minimum": 1},
        "den": {"type": "integer", "minimum": 1}
      }
    },
    "stream": {
      "type": "object",
      "required": ["stream_id", "start_time_ns", "end_time_ns"],
      "additionalProperties": false,
      "properties": {
        "stream_id": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "^\\S(?:.*\\S)?$"},
        "start_time_ns": {"$ref": "#/$defs/nanoseconds"},
        "end_time_ns": {"$ref": "#/$defs/nanoseconds"},
        "frame_rate": {"oneOf": [{"$ref": "#/$defs/frame_rate"}, {"type": "null"}]},
        "declared_frame_count": {"type": ["integer", "null"], "minimum": 0},
        "time_domain": {"type": ["string", "null"], "enum": ["UTC", "ROS", "DEVICE", "HOST", "MONOTONIC", "UNKNOWN", null]},
        "clock_source": {"type": ["string", "null"], "enum": ["PTP", "NTP", "ROS_CLOCK", "DEVICE_CLOCK", "HOST_CLOCK", "MONOTONIC", "EXTERNAL", "UNKNOWN", null]},
        "clock_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 200},
        "drift_ppm": {"type": ["number", "null"]}
      }
    },
    "group": {
      "type": "object",
      "required": ["group_key", "streams"],
      "additionalProperties": false,
      "properties": {
        "group_key": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "^\\S(?:.*\\S)?$"},
        "streams": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/stream"}}
      }
    }
  }
}
