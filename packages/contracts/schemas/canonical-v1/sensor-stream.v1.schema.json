{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ddp.local/schemas/canonical/sensor-stream.v1.schema.json",
  "title": "DDP Canonical SensorStream v1",
  "description": "非视频传感器流（IMU / 关节 / 力/力矩等）的声明。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "stream_id",
    "missing_fields"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "ddp.canonical/1.0.0",
        "ddp.canonical/1.1.0"
      ]
    },
    "stream_id": {
      "type": "string"
    },
    "sensor_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "sensor_type": {
      "type": [
        "string",
        "null"
      ]
    },
    "modality": {
      "type": [
        "string",
        "null"
      ]
    },
    "sample_rate_hz": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "channel_names": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "unit": {
      "type": [
        "string",
        "null"
      ]
    },
    "quantity_kind": {
      "type": [
        "string",
        "null"
      ]
    },
    "frame_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "frame_convention": {
      "type": [
        "string",
        "null"
      ]
    },
    "duration_ns": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^-?(0|[1-9][0-9]*)$"
    },
    "sample_count": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "storage_reference": {
      "type": [
        "string",
        "null"
      ]
    },
    "checksum": {
      "type": [
        "string",
        "null"
      ]
    },
    "calibration_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "calibration_version": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "dtype": {
      "type": [
        "string",
        "null"
      ]
    },
    "start_timestamp_ns": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^-?(0|[1-9][0-9]*)$"
    },
    "end_timestamp_ns": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^-?(0|[1-9][0-9]*)$"
    },
    "missing_count": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "invalid_count": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "parser_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "sensor_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "device_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "missing_fields": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "calibration_id",
          "calibration_version",
          "channel_names",
          "checksum",
          "device_id",
          "dtype",
          "duration_ns",
          "end_timestamp_ns",
          "frame_convention",
          "frame_id",
          "invalid_count",
          "missing_count",
          "modality",
          "parser_version",
          "quantity_kind",
          "sample_count",
          "sample_rate_hz",
          "sensor_id",
          "sensor_name",
          "sensor_type",
          "start_timestamp_ns",
          "storage_reference",
          "unit"
        ]
      },
      "uniqueItems": true
    }
  }
}
