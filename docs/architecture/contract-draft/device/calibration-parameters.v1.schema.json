{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ddp.local/schemas/device/calibration-parameters.v1.schema.json",
  "title": "DDP 标定参数 Schema v1",
  "description": "按 calibration_type 校验 CalibrationRecord.parameters。厂商扩展只能放在 extensions，键名形如 vendor.agibot。",
  "type": "object",
  "required": ["calibration_type", "parameters"],
  "properties": {
    "calibration_type": {
      "enum": [
        "INTRINSICS",
        "EXTRINSICS",
        "HAND_EYE",
        "IMU",
        "JOINT_OFFSET",
        "TIME_OFFSET",
        "FORCE_TORQUE",
        "DEPTH_ALIGNMENT"
      ]
    },
    "parameters": {
      "type": "object"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": { "calibration_type": { "const": "INTRINSICS" } },
        "required": ["calibration_type"]
      },
      "then": { "properties": { "parameters": { "$ref": "#/$defs/INTRINSICS" } } }
    },
    {
      "if": {
        "properties": { "calibration_type": { "const": "EXTRINSICS" } },
        "required": ["calibration_type"]
      },
      "then": { "properties": { "parameters": { "$ref": "#/$defs/EXTRINSICS" } } }
    },
    {
      "if": {
        "properties": { "calibration_type": { "const": "HAND_EYE" } },
        "required": ["calibration_type"]
      },
      "then": { "properties": { "parameters": { "$ref": "#/$defs/HAND_EYE" } } }
    },
    {
      "if": {
        "properties": { "calibration_type": { "const": "IMU" } },
        "required": ["calibration_type"]
      },
      "then": { "properties": { "parameters": { "$ref": "#/$defs/IMU" } } }
    },
    {
      "if": {
        "properties": { "calibration_type": { "const": "JOINT_OFFSET" } },
        "required": ["calibration_type"]
      },
      "then": { "properties": { "parameters": { "$ref": "#/$defs/JOINT_OFFSET" } } }
    },
    {
      "if": {
        "properties": { "calibration_type": { "const": "TIME_OFFSET" } },
        "required": ["calibration_type"]
      },
      "then": { "properties": { "parameters": { "$ref": "#/$defs/TIME_OFFSET" } } }
    },
    {
      "if": {
        "properties": { "calibration_type": { "const": "FORCE_TORQUE" } },
        "required": ["calibration_type"]
      },
      "then": { "properties": { "parameters": { "$ref": "#/$defs/FORCE_TORQUE" } } }
    },
    {
      "if": {
        "properties": { "calibration_type": { "const": "DEPTH_ALIGNMENT" } },
        "required": ["calibration_type"]
      },
      "then": { "properties": { "parameters": { "$ref": "#/$defs/DEPTH_ALIGNMENT" } } }
    }
  ],
  "$defs": {
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)+$"
      },
      "additionalProperties": true
    },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "int64_string": {
      "type": "string",
      "pattern": "^-?[0-9]+$"
    },
    "positive_int": {
      "type": "integer",
      "minimum": 1
    },
    "nonnegative_number": {
      "type": "number",
      "minimum": 0
    },
    "positive_number": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "vector3": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 3,
      "maxItems": 3
    },
    "quaternion_wxyz": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 4,
      "maxItems": 4
    },
    "matrix3": {
      "type": "array",
      "items": { "$ref": "#/$defs/vector3" },
      "minItems": 3,
      "maxItems": 3
    },
    "matrix6": {
      "type": "array",
      "items": {
        "type": "array",
        "items": { "type": "number" },
        "minItems": 6,
        "maxItems": 6
      },
      "minItems": 6,
      "maxItems": 6
    },
    "INTRINSICS": {
      "type": "object",
      "required": [
        "camera_model",
        "image_width",
        "image_height",
        "fx",
        "fy",
        "cx",
        "cy",
        "distortion_model",
        "distortion_coefficients",
        "unit"
      ],
      "properties": {
        "camera_model": { "enum": ["PINHOLE", "FISHEYE", "OMNIDIRECTIONAL"] },
        "image_width": { "$ref": "#/$defs/positive_int" },
        "image_height": { "$ref": "#/$defs/positive_int" },
        "fx": { "$ref": "#/$defs/positive_number" },
        "fy": { "$ref": "#/$defs/positive_number" },
        "cx": { "type": "number" },
        "cy": { "type": "number" },
        "skew": { "type": "number", "default": 0 },
        "distortion_model": {
          "enum": ["plumb_bob", "rational_polynomial", "equidistant", "none"]
        },
        "distortion_coefficients": {
          "type": "array",
          "items": { "type": "number" },
          "maxItems": 8
        },
        "unit": { "const": "px" },
        "extensions": { "$ref": "#/$defs/extensions" }
      },
      "additionalProperties": false
    },
    "EXTRINSICS": {
      "type": "object",
      "required": ["translation_m", "rotation_quat_wxyz", "transform_type"],
      "properties": {
        "translation_m": { "$ref": "#/$defs/vector3" },
        "rotation_quat_wxyz": { "$ref": "#/$defs/quaternion_wxyz" },
        "transform_type": { "enum": ["STATIC", "DYNAMIC"] },
        "timestamp_ns": { "$ref": "#/$defs/int64_string" },
        "extensions": { "$ref": "#/$defs/extensions" }
      },
      "additionalProperties": false
    },
    "HAND_EYE": {
      "type": "object",
      "required": [
        "eye_in_hand",
        "base_frame",
        "tool_frame",
        "camera_frame",
        "translation_m",
        "rotation_quat_wxyz",
        "solver"
      ],
      "properties": {
        "eye_in_hand": { "type": "boolean" },
        "base_frame": { "type": "string", "minLength": 1 },
        "tool_frame": { "type": "string", "minLength": 1 },
        "camera_frame": { "type": "string", "minLength": 1 },
        "translation_m": { "$ref": "#/$defs/vector3" },
        "rotation_quat_wxyz": { "$ref": "#/$defs/quaternion_wxyz" },
        "solver": { "type": "string", "minLength": 1, "maxLength": 200 },
        "residual": {
          "type": "object",
          "required": ["translation_m", "rotation_rad"],
          "properties": {
            "translation_m": { "$ref": "#/$defs/nonnegative_number" },
            "rotation_rad": { "$ref": "#/$defs/nonnegative_number" }
          },
          "additionalProperties": false
        },
        "extensions": { "$ref": "#/$defs/extensions" }
      },
      "additionalProperties": false
    },
    "IMU": {
      "type": "object",
      "required": [
        "noise_density",
        "random_walk",
        "bias",
        "gravity_m_s2",
        "axis_alignment",
        "include_gravity"
      ],
      "properties": {
        "noise_density": {
          "type": "object",
          "required": ["accel_m_s2_per_sqrt_hz", "gyro_rad_s_per_sqrt_hz"],
          "properties": {
            "accel_m_s2_per_sqrt_hz": { "$ref": "#/$defs/nonnegative_number" },
            "gyro_rad_s_per_sqrt_hz": { "$ref": "#/$defs/nonnegative_number" }
          },
          "additionalProperties": false
        },
        "random_walk": {
          "type": "object",
          "required": ["accel_m_s3_per_sqrt_hz", "gyro_rad_s2_per_sqrt_hz"],
          "properties": {
            "accel_m_s3_per_sqrt_hz": { "$ref": "#/$defs/nonnegative_number" },
            "gyro_rad_s2_per_sqrt_hz": { "$ref": "#/$defs/nonnegative_number" }
          },
          "additionalProperties": false
        },
        "bias": {
          "type": "object",
          "required": ["accel_m_s2", "gyro_rad_s"],
          "properties": {
            "accel_m_s2": { "$ref": "#/$defs/vector3" },
            "gyro_rad_s": { "$ref": "#/$defs/vector3" }
          },
          "additionalProperties": false
        },
        "gravity_m_s2": { "$ref": "#/$defs/positive_number" },
        "axis_alignment": { "$ref": "#/$defs/matrix3" },
        "include_gravity": { "type": "boolean" },
        "temperature_c": { "type": "number" },
        "translation_m": { "$ref": "#/$defs/vector3" },
        "rotation_quat_wxyz": { "$ref": "#/$defs/quaternion_wxyz" },
        "extensions": { "$ref": "#/$defs/extensions" }
      },
      "dependentRequired": {
        "translation_m": ["rotation_quat_wxyz"],
        "rotation_quat_wxyz": ["translation_m"]
      },
      "additionalProperties": false
    },
    "JOINT_OFFSET": {
      "type": "object",
      "required": ["joint_order", "joint_types", "offsets"],
      "properties": {
        "joint_order": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        },
        "joint_types": {
          "type": "array",
          "items": { "enum": ["REVOLUTE", "PRISMATIC", "CONTINUOUS", "FIXED"] },
          "minItems": 1
        },
        "offsets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["joint_name", "value", "unit"],
            "properties": {
              "joint_name": { "type": "string", "minLength": 1 },
              "value": { "type": "number" },
              "unit": { "enum": ["rad", "m"] }
            },
            "additionalProperties": false
          },
          "minItems": 1
        },
        "extensions": { "$ref": "#/$defs/extensions" }
      },
      "additionalProperties": false
    },
    "TIME_OFFSET": {
      "type": "object",
      "required": ["sensor_id", "reference_sensor_id", "offset_ns", "method"],
      "properties": {
        "sensor_id": { "$ref": "#/$defs/uuid" },
        "reference_sensor_id": { "$ref": "#/$defs/uuid" },
        "offset_ns": { "$ref": "#/$defs/int64_string" },
        "method": {
          "enum": [
            "PTP",
            "NTP",
            "HARDWARE_TRIGGER",
            "CROSS_CORRELATION",
            "SOFTWARE_ESTIMATE",
            "MANUAL"
          ]
        },
        "drift_ppm": { "type": "number" },
        "extensions": { "$ref": "#/$defs/extensions" }
      },
      "additionalProperties": false
    },
    "FORCE_TORQUE": {
      "type": "object",
      "required": ["six_axis_order", "bias", "unit_force", "unit_torque"],
      "properties": {
        "six_axis_order": {
          "type": "array",
          "prefixItems": [
            { "const": "fx" },
            { "const": "fy" },
            { "const": "fz" },
            { "const": "tx" },
            { "const": "ty" },
            { "const": "tz" }
          ],
          "minItems": 6,
          "maxItems": 6,
          "items": false
        },
        "bias": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 6,
          "maxItems": 6
        },
        "unit_force": { "const": "N" },
        "unit_torque": { "const": "N*m" },
        "compensation_matrix": { "$ref": "#/$defs/matrix6" },
        "extensions": { "$ref": "#/$defs/extensions" }
      },
      "additionalProperties": false
    },
    "DEPTH_ALIGNMENT": {
      "type": "object",
      "required": [
        "depth_sensor_id",
        "rgb_sensor_id",
        "target_resolution",
        "depth_scale_m",
        "invalid_value",
        "translation_m",
        "rotation_quat_wxyz"
      ],
      "properties": {
        "depth_sensor_id": { "$ref": "#/$defs/uuid" },
        "rgb_sensor_id": { "$ref": "#/$defs/uuid" },
        "target_resolution": {
          "type": "array",
          "items": { "$ref": "#/$defs/positive_int" },
          "minItems": 2,
          "maxItems": 2
        },
        "depth_scale_m": { "$ref": "#/$defs/positive_number" },
        "invalid_value": { "type": "number" },
        "invalid_mask": { "type": "string" },
        "alignment_method": { "enum": ["HARDWARE", "SOFTWARE", "CALIBRATION"] },
        "translation_m": { "$ref": "#/$defs/vector3" },
        "rotation_quat_wxyz": { "$ref": "#/$defs/quaternion_wxyz" },
        "extensions": { "$ref": "#/$defs/extensions" }
      },
      "additionalProperties": false
    }
  }
}
