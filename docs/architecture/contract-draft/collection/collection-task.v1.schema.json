{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ddp.local/schemas/collection/collection-task.v1.schema.json",
  "title": "DDP CollectionTask v1（草案）",
  "description": "阶段 2 采集任务响应。状态只经具名动作迁移；初始 DRAFT。",
  "version": "ddp.stage2/1.0.0-draft",
  "type": "object",
  "required": ["task_id", "project_id", "code", "name", "status", "priority", "target_episode_count", "target_duration_sec", "submitted_episode_count", "accepted_episode_count", "version", "created_at", "updated_at"],
  "additionalProperties": false,
  "properties": {
    "task_id": {"$ref": "#/$defs/uuid"},
    "project_id": {"$ref": "#/$defs/uuid"},
    "code": {"type": "string", "minLength": 1, "maxLength": 64},
    "name": {"type": "string", "minLength": 1, "maxLength": 200},
    "requirement_id": {"oneOf": [{"$ref": "#/$defs/uuid"}, {"type": "null"}]},
    "plan_id": {"oneOf": [{"$ref": "#/$defs/uuid"}, {"type": "null"}]},
    "sop_id": {"oneOf": [{"$ref": "#/$defs/uuid"}, {"type": "null"}]},
    "sop_version": {"type": ["string", "null"], "maxLength": 64},
    "scenario_id": {"oneOf": [{"$ref": "#/$defs/uuid"}, {"type": "null"}]},
    "action_spec_id": {"oneOf": [{"$ref": "#/$defs/uuid"}, {"type": "null"}]},
    "action_spec_version": {"type": ["string", "null"], "maxLength": 64},
    "status": {"$ref": "#/$defs/status"},
    "priority": {"type": "string", "enum": ["P0", "P1", "P2"]},
    "assigned_to": {"oneOf": [{"$ref": "#/$defs/uuid"}, {"type": "null"}]},
    "assigned_robot_id": {"oneOf": [{"$ref": "#/$defs/uuid"}, {"type": "null"}]},
    "assigned_device_ids": {"type": "array", "items": {"$ref": "#/$defs/uuid"}, "uniqueItems": true},
    "assigned_sensor_ids": {"type": "array", "items": {"$ref": "#/$defs/uuid"}, "uniqueItems": true},
    "location_id": {"oneOf": [{"$ref": "#/$defs/uuid"}, {"type": "null"}]},
    "scheduled_start": {"oneOf": [{"$ref": "#/$defs/date_time"}, {"type": "null"}]},
    "scheduled_end": {"oneOf": [{"$ref": "#/$defs/date_time"}, {"type": "null"}]},
    "actual_start": {"oneOf": [{"$ref": "#/$defs/date_time"}, {"type": "null"}]},
    "actual_end": {"oneOf": [{"$ref": "#/$defs/date_time"}, {"type": "null"}]},
    "target_episode_count": {"type": "integer", "minimum": 0},
    "target_duration_sec": {"type": "integer", "minimum": 0},
    "submitted_episode_count": {"type": "integer", "minimum": 0},
    "accepted_episode_count": {"type": "integer", "minimum": 0},
    "quality_summary": {"type": ["object", "null"], "additionalProperties": true},
    "status_reason": {"type": ["string", "null"], "maxLength": 1000},
    "blocked_reason": {"type": ["string", "null"], "maxLength": 1000},
    "version": {"type": "integer", "minimum": 1},
    "created_at": {"$ref": "#/$defs/date_time"},
    "updated_at": {"$ref": "#/$defs/date_time"},
    "created_by": {"$ref": "#/$defs/uuid"},
    "updated_by": {"$ref": "#/$defs/uuid"}
  },
  "$defs": {
    "uuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "date_time": {"type": "string", "format": "date-time"},
    "status": {"type": "string", "enum": ["DRAFT", "PENDING_REVIEW", "APPROVED", "READY", "ASSIGNED", "IN_PROGRESS", "PAUSED", "BLOCKED", "SUBMITTED", "DATA_CHECKING", "ACCEPTED", "REJECTED", "REWORK", "COMPLETED", "CANCELLED"]}
  }
}
