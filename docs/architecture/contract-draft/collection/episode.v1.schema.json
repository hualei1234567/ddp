{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ddp.local/schemas/collection/episode.v1.schema.json",
  "title": "DDP Episode v1（草案）",
  "description": "阶段 2 Episode 响应。READY 起冻结数据字段；修订创建新 episode_version。",
  "version": "ddp.stage2/1.0.0-draft",
  "type": "object",
  "required": [
    "episode_id",
    "episode_lineage_id",
    "episode_version",
    "project_id",
    "code",
    "raw_asset_ids",
    "start_time_ns",
    "end_time_ns",
    "duration_ns",
    "time_domain",
    "time_base",
    "canonical_schema_version",
    "pipeline_id",
    "pipeline_version",
    "segmentation_rule_version",
    "status",
    "quality_status",
    "annotation_status",
    "frame_count",
    "calibration_snapshot",
    "manifest_key",
    "manifest_sha256",
    "version",
    "created_at",
    "updated_at"
  ],
  "additionalProperties": false,
  "properties": {
    "episode_id": {"$ref": "#/$defs/uuid"},
    "episode_lineage_id": {"$ref": "#/$defs/uuid"},
    "episode_version": {"type": "integer", "minimum": 1},
    "project_id": {"$ref": "#/$defs/uuid"},
    "code": {"type": "string", "minLength": 1, "maxLength": 64},
    "task_id": {"oneOf": [{"$ref": "#/$defs/uuid"}, {"type": "null"}]},
    "batch_id": {"oneOf": [{"$ref": "#/$defs/uuid"}, {"type": "null"}]},
    "robot_id": {"oneOf": [{"$ref": "#/$defs/uuid"}, {"type": "null"}]},
    "device_ids": {"type": "array", "items": {"$ref": "#/$defs/uuid"}, "uniqueItems": true},
    "sensor_ids": {"type": "array", "items": {"$ref": "#/$defs/uuid"}, "uniqueItems": true},
    "raw_asset_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/uuid"}
    },
    "start_time_ns": {"$ref": "#/$defs/int64_string"},
    "end_time_ns": {"$ref": "#/$defs/int64_string"},
    "duration_ns": {"$ref": "#/$defs/int64_string"},
    "time_domain": {"type": "string", "enum": ["UTC"]},
    "time_base": {"$ref": "#/$defs/time_base"},
    "canonical_schema_version": {"type": "string", "minLength": 1, "maxLength": 64},
    "pipeline_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "pipeline_version": {"type": "string", "minLength": 1, "maxLength": 64},
    "segmentation_rule_version": {"type": "string", "minLength": 1, "maxLength": 64},
    "status": {
      "type": "string",
      "enum": ["PENDING", "PROCESSING", "READY", "QUALITY_CHECKING", "ACCEPTED", "COMPLETED", "ARCHIVED", "FAILED", "REJECTED", "INVALIDATED"]
    },
    "quality_status": {"type": "string", "enum": ["NOT_CHECKED", "PASS", "WARN", "FAIL"]},
    "annotation_status": {"type": "string", "enum": ["NOT_STARTED", "IN_PROGRESS", "SUBMITTED", "APPROVED", "REJECTED"]},
    "success": {"type": ["boolean", "null"]},
    "failure_reason": {"oneOf": [{"type": "string", "maxLength": 2000}, {"type": "null"}]},
    "scene_labels": {"type": "array", "items": {"type": "string", "maxLength": 100}, "uniqueItems": true},
    "language_instruction": {"oneOf": [{"type": "string", "maxLength": 2000}, {"type": "null"}]},
    "frame_count": {"type": "integer", "minimum": 0},
    "calibration_snapshot": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/calibration_snapshot_item"}
    },
    "manifest_key": {"type": "string", "minLength": 1, "maxLength": 1024},
    "manifest_sha256": {"$ref": "#/$defs/sha256"},
    "preview_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["preview_id", "object_key", "content_type"],
        "additionalProperties": false,
        "properties": {
          "preview_id": {"type": "string", "maxLength": 64},
          "object_key": {"type": "string", "maxLength": 1024},
          "content_type": {"type": "string", "maxLength": 200},
          "sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
        }
      }
    },
    "supersedes_id": {"oneOf": [{"$ref": "#/$defs/uuid"}, {"type": "null"}]},
    "version": {"type": "integer", "minimum": 1},
    "created_at": {"$ref": "#/$defs/date_time"},
    "updated_at": {"$ref": "#/$defs/date_time"},
    "created_by": {"$ref": "#/$defs/uuid"},
    "updated_by": {"$ref": "#/$defs/uuid"}
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "date_time": {"type": "string", "format": "date-time"},
    "int64_string": {"type": "string", "pattern": "^-?[0-9]+$"},
    "time_base": {
      "type": "object",
      "required": ["time_domain", "clock_source", "sync_method", "sync_status"],
      "additionalProperties": false,
      "properties": {
        "time_domain": {"type": "string", "enum": ["UTC", "ROS", "DEVICE", "HOST", "MONOTONIC", "UNKNOWN"]},
        "clock_source": {"type": "string", "enum": ["PTP", "NTP", "ROS_CLOCK", "DEVICE_CLOCK", "HOST_CLOCK", "MONOTONIC", "EXTERNAL", "UNKNOWN"]},
        "clock_id": {"type": ["string", "null"], "maxLength": 200},
        "offset_to_utc_ns": {"oneOf": [{"$ref": "#/$defs/int64_string"}, {"type": "null"}]},
        "drift_ppm": {"type": ["number", "null"]},
        "uncertainty_ns": {"oneOf": [{"$ref": "#/$defs/int64_string"}, {"type": "null"}]},
        "sync_method": {"type": "string", "enum": ["PTP", "NTP", "HARDWARE_TRIGGER", "SOFTWARE_ESTIMATE", "MANUAL", "NONE"]},
        "sync_ref": {"type": ["string", "null"], "maxLength": 200},
        "sync_status": {"type": "string", "enum": ["VERIFIED", "DEGRADED", "UNVERIFIED", "FAILED"]}
      }
    },
    "calibration_snapshot_item": {
      "type": "object",
      "required": ["calibration_id", "calibration_version", "checksum", "target_type", "target_id", "schema_version"],
      "additionalProperties": false,
      "properties": {
        "calibration_id": {"$ref": "#/$defs/uuid"},
        "calibration_version": {"type": "integer", "minimum": 1},
        "checksum": {"$ref": "#/$defs/sha256"},
        "target_type": {"type": "string", "enum": ["ROBOT", "DEVICE", "SENSOR", "SYSTEM"]},
        "target_id": {"$ref": "#/$defs/uuid"},
        "schema_version": {"type": "string", "minLength": 1, "maxLength": 64}
      }
    }
  }
}
