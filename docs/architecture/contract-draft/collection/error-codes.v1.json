{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ddp.local/schemas/collection/error-codes.v1.json",
  "title": "DDP 阶段 2 错误码注册表 v1（草案）",
  "description": "阶段 2 HTTP 与 Job/领域内部错误码。客户端必须按 code 分支；未知 code 不得默认成功。HTTP 状态码与可重试性为契约，不得在实现中随意改变。",
  "version": "ddp.stage2/1.0.0-draft",
  "status": "DRAFT",
  "envelope": {
    "required": ["error"],
    "properties": {
      "error": {
        "required": ["code", "message"],
        "optional": ["request_id", "details"],
        "details_rule": "可选字段级错误、missing_part_numbers、expected/actual；不得包含对象存储凭据、Token、跨项目 ID"
      }
    }
  },
  "codes": [
    {"code": "not_authenticated", "http": 401, "retryable": false, "surface": "api", "description": "未登录或 Token 失效；沿用阶段 0/1 名称"},
    {"code": "forbidden", "http": 403, "retryable": false, "surface": "api", "description": "权限不足、职责分离违规、四眼失败"},
    {"code": "project_scope_denied", "http": 403, "retryable": false, "surface": "api", "description": "非项目成员或项目停用"},
    {"code": "asset_quarantined", "http": 403, "retryable": false, "surface": "api", "description": "资产处于隔离区，下载/使用被拒绝"},
    {"code": "resource_not_found", "http": 404, "retryable": false, "surface": "api", "description": "同项目内不存在；跨项目统一不可见"},
    {"code": "not_found", "http": 404, "retryable": false, "surface": "api", "description": "平台级资源不存在；兼容阶段 0"},
    {"code": "conflict", "http": 409, "retryable": false, "surface": "api", "description": "通用冲突；兼容阶段 0/1"},
    {"code": "state_transition_invalid", "http": 409, "retryable": false, "surface": "api", "description": "非法状态迁移、终态回退、跳过必经状态"},
    {"code": "version_conflict", "http": 409, "retryable": true, "surface": "api", "description": "If-Match/乐观锁不匹配；重读后可重试"},
    {"code": "resource_immutable", "http": 409, "retryable": false, "surface": "api", "description": "已冻结/不可变资源被修改"},
    {"code": "duplicate_resource", "http": 409, "retryable": false, "surface": "api", "description": "业务键/编码重复"},
    {"code": "idempotency_key_reused", "http": 409, "retryable": false, "surface": "api", "description": "同幂等键不同请求体"},
    {"code": "upload_incomplete", "http": 409, "retryable": true, "surface": "api", "description": "分片缺失或未确认；补传后重试"},
    {"code": "upload_part_conflict", "http": 409, "retryable": true, "surface": "api", "description": "同分片号内容/ETag/大小不同；修正后重传"},
    {"code": "upload_session_not_uploading", "http": 409, "retryable": false, "surface": "api", "description": "会话不在可上传状态"},
    {"code": "episode_overlap_conflict", "http": 409, "retryable": true, "surface": "api", "description": "同资产/流时间区间重叠且未允许"},
    {"code": "episode_already_exists", "http": 409, "retryable": false, "surface": "api", "description": "同资产/规则/范围已存在 Episode"},
    {"code": "job_not_retryable", "http": 409, "retryable": false, "surface": "api", "description": "Job 错误不可重试或已达最大次数"},
    {"code": "asset_not_usable", "http": 409, "retryable": false, "surface": "api", "description": "资产非 VALID/ARCHIVED，不能解析/切片"},
    {"code": "lineage_conflict", "http": 409, "retryable": false, "surface": "api", "description": "血缘边重复/成环/跨项目"},
    {"code": "upload_session_expired", "http": 410, "retryable": true, "surface": "api", "description": "上传会话过期；新建会话重试"},
    {"code": "asset_tombstoned", "http": 410, "retryable": false, "surface": "api", "description": "资产已墓碑，下载/使用被拒绝"},
    {"code": "file_too_large", "http": 413, "retryable": false, "surface": "api", "description": "超过会话/项目大小上限"},
    {"code": "file_type_unsupported", "http": 415, "retryable": false, "surface": "api", "description": "声明类型不在白名单"},
    {"code": "validation_failed", "http": 422, "retryable": false, "surface": "api", "description": "参数/Schema/必填/枚举校验失败"},
    {"code": "file_signature_mismatch", "http": 422, "retryable": false, "surface": "api", "description": "内容签名与声明类型/格式不符"},
    {"code": "hash_mismatch", "http": 422, "retryable": false, "surface": "api", "description": "整文件 SHA256 不一致，或声明自相矛盾"},
    {"code": "size_mismatch", "http": 422, "retryable": true, "surface": "api", "description": "分片总和/声明大小/实际大小不一致；修正后重试"},
    {"code": "filename_invalid", "http": 422, "retryable": false, "surface": "api", "description": "文件名含路径/控制字符/超长"},
    {"code": "quarantine_release_denied", "http": 422, "retryable": false, "surface": "api", "description": "隔离放行证据/审批不足"},
    {"code": "calibration_not_active", "http": 422, "retryable": false, "surface": "api", "description": "采集时点无有效 ACTIVE 标定"},
    {"code": "calibration_snapshot_invalid", "http": 422, "retryable": false, "surface": "api", "description": "标定快照版本/校验和/目标不匹配"},
    {"code": "episode_time_range_invalid", "http": 422, "retryable": false, "surface": "api", "description": "起止时间非法、超出资产范围或 duration 不符"},
    {"code": "time_base_invalid", "http": 422, "retryable": false, "surface": "api", "description": "时间基准缺失、非法或 UNVERIFIED/FAILED"},
    {"code": "manifest_hash_mismatch", "http": 422, "retryable": false, "surface": "api", "description": "Manifest Hash 校验失败"},
    {"code": "manifest_schema_invalid", "http": 422, "retryable": false, "surface": "api", "description": "Manifest 不符合 Canonical Schema"},
    {"code": "unsupported_format", "http": 422, "retryable": false, "surface": "api", "description": "已知但暂不支持解析的格式"},
    {"code": "malware_detected", "http": 422, "retryable": false, "surface": "api", "description": "恶意扫描命中"},
    {"code": "scanner_unavailable", "http": 422, "retryable": true, "surface": "api", "description": "扫描服务不可用，无法放行；恢复后重试"},
    {"code": "job_config_invalid", "http": 422, "retryable": false, "surface": "api", "description": "Pipeline/Parser/配置版本非法"},
    {"code": "precondition_required", "http": 428, "retryable": false, "surface": "api", "description": "缺少 If-Match"},
    {"code": "rate_limited", "http": 429, "retryable": true, "surface": "api", "description": "触发限流；退避重试"},
    {"code": "internal_error", "http": 500, "retryable": false, "surface": "api", "description": "未预期错误"},
    {"code": "dependency_unavailable", "http": 503, "retryable": true, "surface": "api", "description": "数据库/队列/扫描服务不可用"},
    {"code": "object_storage_unavailable", "http": 503, "retryable": true, "surface": "api", "description": "对象存储不可用"},
    {"code": "storage_quota_exceeded", "http": 507, "retryable": false, "surface": "api", "description": "项目存储配额不足；需扩容/清理"},

    {"code": "job_timeout", "http": null, "retryable": true, "surface": "job", "description": "Job 超过 timeout_sec"},
    {"code": "hash_compute_failed", "http": null, "retryable": true, "surface": "job", "description": "流式 Hash 计算失败"},
    {"code": "object_missing", "http": null, "retryable": false, "surface": "job", "description": "对象 Key 不存在或大小不一致"},
    {"code": "parse_failed", "http": null, "retryable": true, "surface": "job", "description": "格式可识别但解析失败；换 Parser 版本后可重试"},
    {"code": "parser_unsupported", "http": null, "retryable": false, "surface": "job", "description": "无可用 Parser"},
    {"code": "metadata_missing", "http": null, "retryable": false, "surface": "job", "description": "缺少关键元数据（时间/通道/单位）"},
    {"code": "time_sync_unverified", "http": null, "retryable": false, "surface": "job", "description": "时间同步无法验证"},
    {"code": "calibration_missing", "http": null, "retryable": false, "surface": "job", "description": "切片所需标定缺失"},
    {"code": "manifest_generation_failed", "http": null, "retryable": true, "surface": "job", "description": "Manifest 生成/校验失败"},
    {"code": "malware_suspected", "http": null, "retryable": false, "surface": "job", "description": "扫描可疑"},
    {"code": "malware_scanner_unavailable", "http": null, "retryable": true, "surface": "job", "description": "扫描服务不可用，资产隔离"},
    {"code": "signature_ambiguous", "http": null, "retryable": false, "surface": "job", "description": "内容签名无法唯一判定"},
    {"code": "metadata_conflict", "http": null, "retryable": false, "surface": "job", "description": "原始元数据与声明/快照冲突"},
    {"code": "duplicate_content", "http": null, "retryable": false, "surface": "job", "description": "内容指纹竞争失败/重复"}
  ]
}
