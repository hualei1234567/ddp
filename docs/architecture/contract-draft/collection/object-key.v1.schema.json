{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ddp.local/schemas/collection/object-key.v1.schema.json",
  "title": "DDP 对象存储 Key 规范 v1（草案）",
  "description": "阶段 2 服务端生成的对象 Key 模板与校验正则。Key 不含原始文件名、用户路径、Token；任何跨项目前缀拒绝。",
  "version": "ddp.stage2/1.0.0-draft",
  "type": "object",
  "required": ["kind", "key"],
  "additionalProperties": false,
  "properties": {
    "kind": {
      "type": "string",
      "enum": ["RAW_CONTENT", "QUARANTINE_SCAN_REPORT", "QUARANTINE_EVIDENCE", "UPLOAD_SCRATCH", "CANONICAL_MANIFEST", "CANONICAL_STREAM_CHUNK", "CANONICAL_PREVIEW", "INGESTION_LOG"]
    },
    "key": {"type": "string", "minLength": 1, "maxLength": 1024}
  },
  "allOf": [
    {"if": {"properties": {"kind": {"const": "RAW_CONTENT"}}}, "then": {"properties": {"key": {"pattern": "^raw/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/[0-9]{4}/[0-9]{2}/[0-9]{2}/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/content\\.[a-z0-9]{1,16}$"}}}},
    {"if": {"properties": {"kind": {"const": "QUARANTINE_SCAN_REPORT"}}}, "then": {"properties": {"key": {"pattern": "^quarantine/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/scan-report\\.json$"}}}},
    {"if": {"properties": {"kind": {"const": "QUARANTINE_EVIDENCE"}}}, "then": {"properties": {"key": {"pattern": "^quarantine/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/evidence/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\\.[a-z0-9]{1,16}$"}}}},
    {"if": {"properties": {"kind": {"const": "UPLOAD_SCRATCH"}}}, "then": {"properties": {"key": {"pattern": "^tmp/uploads/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/scratch$"}}}},
    {"if": {"properties": {"kind": {"const": "CANONICAL_MANIFEST"}}}, "then": {"properties": {"key": {"pattern": "^canonical/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/[1-9][0-9]*/manifest\\.json$"}}}},
    {"if": {"properties": {"kind": {"const": "CANONICAL_STREAM_CHUNK"}}}, "then": {"properties": {"key": {"pattern": "^canonical/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/[1-9][0-9]*/streams/[a-z0-9][a-z0-9_-]{0,63}/part-[0-9]{5}\\.parquet$"}}}},
    {"if": {"properties": {"kind": {"const": "CANONICAL_PREVIEW"}}}, "then": {"properties": {"key": {"pattern": "^canonical/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/[1-9][0-9]*/preview/[a-z0-9][a-z0-9_-]{0,63}\\.[a-z0-9]{1,16}$"}}}},
    {"if": {"properties": {"kind": {"const": "INGESTION_LOG"}}}, "then": {"properties": {"key": {"pattern": "^logs/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/ingestion/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/[1-9][0-9]*\\.log$"}}}}
  ],
  "x-forbidden": [
    "..",
    "\\",
    "//",
    "leading slash",
    "space or control characters",
    "original filename",
    "query string",
    "token or secret",
    "uppercase fixed segments",
    "project_id mismatch with resource/token"
  ],
  "x-examples": {
    "RAW_CONTENT": "raw/018e2a10-0000-7000-8000-000000000001/2026/11/08/018f1f7e-7c00-7a2b-9d10-2f6c1a9b3c4d/content.mcap",
    "CANONICAL_MANIFEST": "canonical/018e2a10-0000-7000-8000-000000000001/018f1f7e-7c00-7a2b-9d10-2f6c1a9b3c4d/1/manifest.json",
    "CANONICAL_STREAM_CHUNK": "canonical/018e2a10-0000-7000-8000-000000000001/018f1f7e-7c00-7a2b-9d10-2f6c1a9b3c4d/1/streams/cam-front/part-00000.parquet",
    "INGESTION_LOG": "logs/018e2a10-0000-7000-8000-000000000001/ingestion/018f1f7e-7c00-7a2b-9d10-2f6c1a9b3c4e/1.log"
  }
}
