{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ddp.local/schemas/collection/ingestion-job.v1.schema.json",
  "title": "DDP IngestionJob v1（草案）",
  "description": "阶段 2 接入/校验/解析/切片 Job 响应。失败必须记录错误码、摘要与日志；重试有上限。",
  "version": "ddp.stage2/1.0.0-draft",
  "type": "object",
  "required": ["job_id", "project_id", "job_type", "status", "attempt", "max_attempts", "timeout_sec", "version", "created_at", "updated_at"],
  "additionalProperties": false,
  "properties": {
    "job_id": {"$ref": "#/$defs/uuid"},
    "project_id": {"$ref": "#/$defs/uuid"},
    "job_type": {"type": "string", "enum": ["VALIDATE", "PARSE_METADATA", "SEGMENT_EPISODE", "REVALIDATE"]},
    "raw_asset_id": {"oneOf": [{"$ref": "#/$defs/uuid"}, {"type": "null"}]},
    "raw_asset_ids": {"type": "array", "items": {"$ref": "#/$defs/uuid"}, "uniqueItems": true},
    "input_manifest_key": {"type": ["string", "null"], "maxLength": 1024},
    "status": {"$ref": "#/$defs/status"},
    "idempotency_key": {"type": ["string", "null"], "maxLength": 128},
    "attempt": {"type": "integer", "minimum": 1},
    "max_attempts": {"type": "integer", "minimum": 1},
    "timeout_sec": {"type": "integer", "minimum": 1},
    "pipeline_id": {"type": ["string", "null"], "maxLength": 128},
    "pipeline_version": {"type": ["string", "null"], "maxLength": 64},
    "parser_id": {"type": ["string", "null"], "maxLength": 128},
    "parser_version": {"type": ["string", "null"], "maxLength": 64},
    "config_hash": {"type": ["string", "null"], "maxLength": 71},
    "started_at": {"oneOf": [{"$ref": "#/$defs/date_time"}, {"type": "null"}]},
    "finished_at": {"oneOf": [{"$ref": "#/$defs/date_time"}, {"type": "null"}]},
    "error_code": {"type": ["string", "null"], "maxLength": 64},
    "error_summary": {"type": ["string", "null"], "maxLength": 2000},
    "output_refs": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
    "log_ref": {"type": ["string", "null"], "maxLength": 1024},
    "metrics": {"type": "object", "additionalProperties": true},
    "version": {"type": "integer", "minimum": 1},
    "created_at": {"$ref": "#/$defs/date_time"},
    "updated_at": {"$ref": "#/$defs/date_time"}
  },
  "$defs": {
    "uuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "date_time": {"type": "string", "format": "date-time"},
    "status": {"type": "string", "enum": ["QUEUED", "RUNNING", "SUCCEEDED", "FAILED", "CANCELLING", "CANCELLED"]}
  }
}
