{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ddp.local/schemas/annotation/label-schema.v1.schema.json",
  "title": "DDP AnnotationSchema v1（草案）",
  "description": "阶段 3 标签 Schema。发布后标签定义不可变；修改创建新 schema_version。",
  "version": "ddp.stage3/1.0.0-draft",
  "type": "object",
  "required": [
    "schema_id",
    "schema_lineage_id",
    "schema_version",
    "project_id",
    "code",
    "name",
    "status",
    "annotation_levels",
    "labels",
    "compatibility",
    "schema_sha256",
    "version",
    "created_at",
    "updated_at"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_id": {"$ref": "#/$defs/uuid"},
    "schema_lineage_id": {"$ref": "#/$defs/uuid"},
    "schema_version": {"type": "integer", "minimum": 1},
    "project_id": {"$ref": "#/$defs/uuid"},
    "code": {"type": "string", "minLength": 1, "maxLength": 64},
    "name": {"type": "string", "minLength": 1, "maxLength": 200},
    "description": {"type": ["string", "null"], "maxLength": 2000},
    "status": {"type": "string", "enum": ["DRAFT", "PENDING_REVIEW", "PUBLISHED", "DEPRECATED", "REVOKED"]},
    "annotation_levels": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "enum": ["TASK", "EPISODE", "TIME_RANGE", "ACTION_SEGMENT", "FRAME", "OBJECT_TRACK"]}
    },
    "labels": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/label_definition"}
    },
    "compatibility": {"type": "string", "enum": ["BACKWARD_COMPATIBLE", "BREAKING"]},
    "schema_sha256": {"$ref": "#/$defs/sha256"},
    "supersedes_id": {"oneOf": [{"$ref": "#/$defs/uuid"}, {"type": "null"}]},
    "published_at": {"oneOf": [{"$ref": "#/$defs/date_time"}, {"type": "null"}]},
    "deprecated_at": {"oneOf": [{"$ref": "#/$defs/date_time"}, {"type": "null"}]},
    "revoked_at": {"oneOf": [{"$ref": "#/$defs/date_time"}, {"type": "null"}]},
    "version": {"type": "integer", "minimum": 1},
    "created_at": {"$ref": "#/$defs/date_time"},
    "updated_at": {"$ref": "#/$defs/date_time"},
    "created_by": {"$ref": "#/$defs/uuid"},
    "updated_by": {"$ref": "#/$defs/uuid"}
  },
  "$defs": {
    "uuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "date_time": {"type": "string", "format": "date-time"},
    "label_definition": {
      "type": "object",
      "required": ["label_key", "label_type", "required", "level", "visibility"],
      "additionalProperties": false,
      "properties": {
        "label_key": {"type": "string", "minLength": 1, "maxLength": 100},
        "label_type": {"type": "string", "enum": ["ENUM", "MULTI_ENUM", "BOOLEAN", "NUMBER", "STRING", "FREE_TEXT", "TIME_RANGE", "ACTION_SEGMENT", "OBJECT_TRACK", "JSON"]},
        "required": {"type": "boolean"},
        "level": {"type": "string", "enum": ["TASK", "EPISODE", "TIME_RANGE", "ACTION_SEGMENT", "FRAME", "OBJECT_TRACK"]},
        "description": {"type": ["string", "null"], "maxLength": 2000},
        "visibility": {"type": "string", "enum": ["ANNOTATOR", "REVIEWER_ONLY", "GOLD_ONLY", "SYSTEM_ONLY"]},
        "value_spec": {"$ref": "#/$defs/value_spec"},
        "quality_rules": {"type": "array", "items": {"type": "string", "maxLength": 200}, "uniqueItems": true}
      }
    },
    "value_spec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enum_values": {"type": "array", "items": {"type": "string", "maxLength": 200}, "uniqueItems": true},
        "min_value": {"type": ["number", "null"]},
        "max_value": {"type": ["number", "null"]},
        "unit": {"type": ["string", "null"], "maxLength": 64},
        "min_duration_ns": {"oneOf": [{"$ref": "#/$defs/int64_string"}, {"type": "null"}]},
        "max_duration_ns": {"oneOf": [{"$ref": "#/$defs/int64_string"}, {"type": "null"}]},
        "iou_threshold": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "max_length": {"type": ["integer", "null"], "minimum": 0},
        "json_schema_ref": {"type": ["string", "null"], "maxLength": 1024}
      }
    },
    "int64_string": {"type": "string", "pattern": "^-?[0-9]+$"}
  }
}
