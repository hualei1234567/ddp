{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ddp.local/schemas/annotation/annotation-submission.v1.schema.json",
  "title": "DDP AnnotationSubmission v1（草案）",
  "description": "阶段 3 标注提交。提交后不可原地编辑；修订创建新 submission_version，旧版本保留。",
  "version": "ddp.stage3/1.0.0-draft",
  "type": "object",
  "required": [
    "submission_id",
    "project_id",
    "task_id",
    "batch_id",
    "assignment_id",
    "annotator_id",
    "submission_version",
    "status",
    "schema_id",
    "schema_version",
    "schema_sha256",
    "item_count",
    "records_digest",
    "data_source",
    "version",
    "created_at",
    "updated_at"
  ],
  "additionalProperties": false,
  "properties": {
    "submission_id": {"$ref": "#/$defs/uuid"},
    "project_id": {"$ref": "#/$defs/uuid"},
    "task_id": {"$ref": "#/$defs/uuid"},
    "batch_id": {"$ref": "#/$defs/uuid"},
    "assignment_id": {"$ref": "#/$defs/uuid"},
    "annotator_id": {"$ref": "#/$defs/uuid"},
    "submission_version": {"type": "integer", "minimum": 1},
    "status": {"type": "string", "enum": ["DRAFT", "SUBMITTED", "IN_REVIEW", "APPROVED", "REJECTED", "ESCALATED", "ARBITRATING", "RESOLVED_APPROVED", "RESOLVED_REJECTED", "RESOLVED_REWORK", "REWORK_REQUIRED", "WITHDRAWN", "SUPERSEDED"]},
    "schema_id": {"$ref": "#/$defs/uuid"},
    "schema_version": {"type": "integer", "minimum": 1},
    "schema_sha256": {"$ref": "#/$defs/sha256"},
    "item_count": {"type": "integer", "minimum": 0},
    "records_digest": {"$ref": "#/$defs/sha256"},
    "record_refs": {"type": "array", "items": {"$ref": "#/$defs/uuid"}, "uniqueItems": true},
    "review_id": {"oneOf": [{"$ref": "#/$defs/uuid"}, {"type": "null"}]},
    "arbitration_id": {"oneOf": [{"$ref": "#/$defs/uuid"}, {"type": "null"}]},
    "supersedes_id": {"oneOf": [{"$ref": "#/$defs/uuid"}, {"type": "null"}]},
    "data_source": {"type": "string", "enum": ["REAL", "SYNTHETIC", "MIXED", "UNKNOWN"]},
    "submitted_at": {"oneOf": [{"$ref": "#/$defs/date_time"}, {"type": "null"}]},
    "decided_at": {"oneOf": [{"$ref": "#/$defs/date_time"}, {"type": "null"}]},
    "reason": {"type": ["string", "null"], "maxLength": 2000},
    "auto_label": {"oneOf": [{"$ref": "#/$defs/auto_label"}, {"type": "null"}]},
    "version": {"type": "integer", "minimum": 1},
    "created_at": {"$ref": "#/$defs/date_time"},
    "updated_at": {"$ref": "#/$defs/date_time"},
    "created_by": {"$ref": "#/$defs/uuid"},
    "updated_by": {"$ref": "#/$defs/uuid"}
  },
  "$defs": {
    "uuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "date_time": {"type": "string", "format": "date-time"},
    "auto_label": {
      "type": "object",
      "required": ["model_id", "model_version", "prompt_version", "confidence", "human_confirmed"],
      "additionalProperties": false,
      "properties": {
        "model_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "model_version": {"type": "string", "minLength": 1, "maxLength": 64},
        "prompt_version": {"type": "string", "minLength": 1, "maxLength": 64},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "human_confirmed": {"type": "boolean"},
        "suggestion_count": {"type": "integer", "minimum": 0},
        "accepted_count": {"type": "integer", "minimum": 0}
      }
    }
  }
}
