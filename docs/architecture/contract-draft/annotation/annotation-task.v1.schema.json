{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ddp.local/schemas/annotation/annotation-task.v1.schema.json",
  "title": "DDP AnnotationTask v1（草案）",
  "description": "阶段 3 标注任务。任务批准时冻结样本集与 Schema 快照；核心字段仅 DRAFT 可编辑。",
  "version": "ddp.stage3/1.0.0-draft",
  "type": "object",
  "required": [
    "task_id",
    "project_id",
    "code",
    "name",
    "status",
    "sample_set_id",
    "schema_id",
    "schema_version",
    "schema_sha256",
    "target_item_count",
    "target_episode_count",
    "priority",
    "progress",
    "version",
    "created_at",
    "updated_at"
  ],
  "additionalProperties": false,
  "properties": {
    "task_id": {"$ref": "#/$defs/uuid"},
    "project_id": {"$ref": "#/$defs/uuid"},
    "code": {"type": "string", "minLength": 1, "maxLength": 64},
    "name": {"type": "string", "minLength": 1, "maxLength": 200},
    "description": {"type": ["string", "null"], "maxLength": 2000},
    "status": {"type": "string", "enum": ["DRAFT", "PENDING_REVIEW", "APPROVED", "READY", "ASSIGNED", "IN_PROGRESS", "PAUSED", "BLOCKED", "SUBMITTED", "REVIEWING", "ARBITRATION", "ACCEPTED", "REJECTED", "REWORK", "COMPLETED", "CANCELLED", "ARCHIVED"]},
    "sample_set_id": {"$ref": "#/$defs/uuid"},
    "schema_id": {"$ref": "#/$defs/uuid"},
    "schema_version": {"type": "integer", "minimum": 1},
    "schema_sha256": {"$ref": "#/$defs/sha256"},
    "gold_set_id": {"oneOf": [{"$ref": "#/$defs/uuid"}, {"type": "null"}]},
    "iaa_policy": {"$ref": "#/$defs/iaa_policy"},
    "quality_policy": {"$ref": "#/$defs/quality_policy"},
    "assignment_mode": {"type": "string", "enum": ["MANUAL", "CLAIM", "MIXED"]},
    "target_item_count": {"type": "integer", "minimum": 1},
    "target_episode_count": {"type": "integer", "minimum": 1},
    "due_at": {"oneOf": [{"$ref": "#/$defs/date_time"}, {"type": "null"}]},
    "priority": {"type": "string", "enum": ["P0", "P1", "P2", "P3"]},
    "progress": {"$ref": "#/$defs/progress"},
    "quality_summary": {"type": ["object", "null"], "additionalProperties": true},
    "iaa_report_id": {"oneOf": [{"$ref": "#/$defs/uuid"}, {"type": "null"}]},
    "accepted_at": {"oneOf": [{"$ref": "#/$defs/date_time"}, {"type": "null"}]},
    "completed_at": {"oneOf": [{"$ref": "#/$defs/date_time"}, {"type": "null"}]},
    "allowed_actions": {"type": "array", "items": {"type": "string", "maxLength": 64}, "uniqueItems": true},
    "version": {"type": "integer", "minimum": 1},
    "created_at": {"$ref": "#/$defs/date_time"},
    "updated_at": {"$ref": "#/$defs/date_time"},
    "created_by": {"$ref": "#/$defs/uuid"},
    "updated_by": {"$ref": "#/$defs/uuid"}
  },
  "$defs": {
    "uuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "date_time": {"type": "string", "format": "date-time"},
    "iaa_policy": {
      "type": "object",
      "required": ["enabled", "overlap_rate", "metrics", "min_overlap_items", "version"],
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "overlap_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "metrics": {"type": "array", "items": {"type": "string", "enum": ["PERCENT_AGREEMENT", "COHEN_KAPPA", "FLEISS_KAPPA", "KRIPPENDORFF_ALPHA", "SPAN_F1", "BOUNDARY_MAE"]}, "uniqueItems": true},
        "min_overlap_items": {"type": "integer", "minimum": 2},
        "version": {"type": "string", "minLength": 1, "maxLength": 64}
      }
    },
    "quality_policy": {
      "type": "object",
      "required": ["sampling_rate", "sample_types", "version"],
      "additionalProperties": false,
      "properties": {
        "sampling_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "sample_types": {"type": "array", "items": {"type": "string", "enum": ["RANDOM", "STRATIFIED", "RISK_BASED", "GOLD_SET", "IAA_OVERLAP"]}, "uniqueItems": true},
        "strata": {"type": "array", "items": {"type": "string", "maxLength": 100}, "uniqueItems": true},
        "version": {"type": "string", "minLength": 1, "maxLength": 64}
      }
    },
    "progress": {
      "type": "object",
      "required": ["total_items", "submitted_items", "approved_items", "rejected_items", "rework_items", "arbitration_items"],
      "additionalProperties": false,
      "properties": {
        "total_items": {"type": "integer", "minimum": 0},
        "submitted_items": {"type": "integer", "minimum": 0},
        "approved_items": {"type": "integer", "minimum": 0},
        "rejected_items": {"type": "integer", "minimum": 0},
        "rework_items": {"type": "integer", "minimum": 0},
        "arbitration_items": {"type": "integer", "minimum": 0},
        "missing_semantics": {"type": "string", "enum": ["NONE", "N/A", "UNKNOWN", "STALE", "PARTIAL"]}
      }
    }
  }
}
