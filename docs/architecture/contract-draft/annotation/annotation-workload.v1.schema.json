{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ddp.local/schemas/annotation/annotation-workload.v1.schema.json",
  "title": "DDP AnnotationWorkload v1（草案）",
  "description": "阶段 3 标注工作量周期汇总。个人明细仅本人/AM/PM/AU 可见；缺失数据区分 0/N/A/Unknown/Stale/Partial。",
  "version": "ddp.stage3/1.0.0-draft",
  "type": "object",
  "required": [
    "workload_id",
    "project_id",
    "user_id",
    "period_start",
    "period_end",
    "assigned_item_count",
    "claimed_item_count",
    "submitted_item_count",
    "approved_item_count",
    "rework_item_count",
    "total_minutes",
    "capacity_minutes",
    "status",
    "version",
    "created_at",
    "updated_at"
  ],
  "additionalProperties": false,
  "properties": {
    "workload_id": {"$ref": "#/$defs/uuid"},
    "project_id": {"$ref": "#/$defs/uuid"},
    "user_id": {"$ref": "#/$defs/uuid"},
    "period_start": {"$ref": "#/$defs/date_time"},
    "period_end": {"$ref": "#/$defs/date_time"},
    "assigned_item_count": {"type": "integer", "minimum": 0},
    "claimed_item_count": {"type": "integer", "minimum": 0},
    "submitted_item_count": {"type": "integer", "minimum": 0},
    "approved_item_count": {"type": "integer", "minimum": 0},
    "rework_item_count": {"type": "integer", "minimum": 0},
    "total_minutes": {"type": "integer", "minimum": 0},
    "capacity_minutes": {"type": "integer", "minimum": 0},
    "utilization_ratio": {"oneOf": [{"type": "number", "minimum": 0}, {"type": "null"}]},
    "status": {"type": "string", "enum": ["NORMAL", "AT_CAPACITY", "OVER_CAPACITY", "STALE", "PARTIAL", "UNKNOWN"]},
    "source_version": {"type": ["string", "null"], "maxLength": 64},
    "missing_semantics": {"type": "string", "enum": ["NONE", "N/A", "UNKNOWN", "STALE", "PARTIAL"]},
    "version": {"type": "integer", "minimum": 1},
    "created_at": {"$ref": "#/$defs/date_time"},
    "updated_at": {"$ref": "#/$defs/date_time"}
  },
  "$defs": {
    "uuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "date_time": {"type": "string", "format": "date-time"}
  }
}
