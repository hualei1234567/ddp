{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ddp.local/schemas/annotation/error-codes.v1.json",
  "title": "DDP 阶段 3 标注错误码注册表 v1（冻结）",
  "description": "阶段 3 HTTP 与 Job/领域错误码。客户端必须按 code 分支；未知 code 不得默认成功。HTTP 状态码与可重试性为契约，不得在实现中随意改变。阶段 2 通用错误码可复用，本表只列阶段 3 新增或特别说明的语义。已随 DDP-323 冻结为 ddp.stage3/1.0.0；HTTP 状态以 backend/app/api/errors.py 为准。",
  "version": "ddp.stage3/1.0.0",
  "status": "FROZEN",
  "frozen_at": "2026-11-09",
  "implementation_alignment": {
    "source_of_truth": "backend/app/api/errors.py 的 _ANNOTATION_STATUS_BY_CODE 与 backend/app/domain/annotation/errors.py",
    "note": "冻结时按实际代码校正 HTTP 状态；未实现代码保留为预留，不得据此声称可用。",
    "corrected_http_status": {
      "annotation_sample_set_not_snapshotted": {"draft": 422, "implemented": 409},
      "annotation_sample_duplicate": {"draft": 409, "implemented": 422},
      "annotation_batch_over_capacity": {"draft": 422, "implemented": 409},
      "annotation_arbitration_quorum_not_met": {"draft": 422, "implemented": 409},
      "gold_set_not_active": {"draft": 422, "implemented": 409},
      "gold_set_schema_incompatible": {"draft": 422, "implemented": 409}
    },
    "not_implemented_codes": [
      "annotation_schema_version_incompatible",
      "annotation_sample_time_range_invalid",
      "annotation_review_conflict",
      "iaa_report_not_ready",
      "annotation_ai_review_required",
      "annotation_ai_source_invalid",
      "annotation_workload_unavailable",
      "annotation_export_not_supported",
      "annotation_lineage_conflict",
      "annotation_metric_unavailable",
      "annotation_outbox_unavailable",
      "iaa_compute_failed",
      "iaa_insufficient_data",
      "gold_set_evaluation_failed",
      "annotation_aggregation_failed",
      "annotation_record_hash_failed",
      "annotation_schema_validation_failed",
      "outbox_publish_failed"
    ]
  },
  "envelope": {
    "required": ["error"],
    "properties": {
      "error": {
        "required": ["code", "message"],
        "optional": ["request_id", "details"],
        "details_rule": "可选字段级错误、item_refs、expected/actual、sample_size；不得包含黄金集期望答案、对象存储凭据、Token、跨项目 ID"
      }
    }
  },
  "reused_stage2_codes": [
    "not_authenticated",
    "forbidden",
    "project_scope_denied",
    "resource_not_found",
    "not_found",
    "conflict",
    "state_transition_invalid",
    "version_conflict",
    "resource_immutable",
    "duplicate_resource",
    "idempotency_key_reused",
    "precondition_required",
    "rate_limited",
    "internal_error",
    "dependency_unavailable"
  ],
  "codes": [
    {"code": "annotation_schema_not_published", "http": 422, "retryable": false, "surface": "api", "description": "Schema 未发布，不能创建/就绪新任务"},
    {"code": "annotation_schema_immutable", "http": 409, "retryable": false, "surface": "api", "description": "已发布 Schema 被原地修改；应创建新版本"},
    {"code": "annotation_schema_version_incompatible", "http": 422, "retryable": false, "surface": "api", "description": "Schema 版本/标签类型/枚举/必填变更不兼容"},
    {"code": "annotation_schema_snapshot_mismatch", "http": 422, "retryable": false, "surface": "api", "description": "提交/任务引用的 Schema 快照与冻结快照不一致"},
    {"code": "annotation_schema_unknown_label", "http": 422, "retryable": false, "surface": "api", "description": "提交含 Schema 未定义的标签键"},
    {"code": "annotation_schema_value_invalid", "http": 422, "retryable": false, "surface": "api", "description": "标签值类型/枚举/范围/时长非法"},
    {"code": "annotation_sample_set_empty", "http": 422, "retryable": false, "surface": "api", "description": "样本集为空，不能快照或创建任务"},
    {"code": "annotation_sample_set_not_snapshotted", "http": 409, "retryable": false, "surface": "api", "description": "任务引用未快照样本集"},
    {"code": "annotation_sample_set_cancelled", "http": 409, "retryable": false, "surface": "api", "description": "任务引用已取消样本集"},
    {"code": "annotation_sample_episode_ineligible", "http": 422, "retryable": false, "surface": "api", "description": "Episode 状态/质量/Manifest/标定/血缘不满足标注输入门禁"},
    {"code": "annotation_sample_duplicate", "http": 422, "retryable": false, "surface": "api", "description": "样本重复且未显式允许同一 Episode 多时间片段"},
    {"code": "annotation_sample_time_range_invalid", "http": 422, "retryable": false, "surface": "api", "description": "样本时间片段非法或超出 Episode 范围"},
    {"code": "annotation_task_not_approved", "http": 409, "retryable": false, "surface": "api", "description": "任务未批准，不能就绪/分配/执行"},
    {"code": "annotation_task_not_ready", "http": 409, "retryable": false, "surface": "api", "description": "任务未就绪，不能分配/开始"},
    {"code": "annotation_task_has_open_work", "http": 409, "retryable": false, "surface": "api", "description": "存在未结分配/提交/复核/仲裁，不能完成/取消"},
    {"code": "annotation_task_rework_limit_exceeded", "http": 409, "retryable": false, "surface": "api", "description": "返工次数超过配置上限，需升级 PO"},
    {"code": "annotation_batch_not_compatible", "http": 409, "retryable": false, "surface": "api", "description": "批次状态/样本/任务不兼容"},
    {"code": "annotation_batch_over_capacity", "http": 409, "retryable": false, "surface": "api", "description": "批次计划量超过任务样本集或目标"},
    {"code": "annotation_assignment_capacity_exceeded", "http": 409, "retryable": false, "surface": "api", "description": "分配/领取超过人员容量，需 AM 审批"},
    {"code": "annotation_assignment_not_owned", "http": 403, "retryable": false, "surface": "api", "description": "分配不属于当前用户或非项目成员"},
    {"code": "annotation_assignment_expired", "http": 410, "retryable": true, "surface": "api", "description": "分配已过期，需重新分配"},
    {"code": "annotation_assignment_revoked", "http": 410, "retryable": false, "surface": "api", "description": "分配已撤销，需重新分配"},
    {"code": "annotation_item_already_assigned", "http": 409, "retryable": false, "surface": "api", "description": "同一样本项已分配给同一人/冲突分配"},
    {"code": "annotation_submission_not_editable", "http": 409, "retryable": false, "surface": "api", "description": "提交已冻结，不能原地编辑；应创建新版本"},
    {"code": "annotation_submission_incomplete", "http": 422, "retryable": false, "surface": "api", "description": "提交缺必填标签/层级/时间片段/证据"},
    {"code": "annotation_submission_schema_mismatch", "http": 422, "retryable": false, "surface": "api", "description": "提交记录与 Schema 版本/快照不一致"},
    {"code": "annotation_submission_not_submitted", "http": 409, "retryable": false, "surface": "api", "description": "提交未进入 SUBMITTED/IN_REVIEW，不能复核/仲裁"},
    {"code": "annotation_submission_already_decided", "http": 409, "retryable": false, "surface": "api", "description": "提交已复核/仲裁终结，不能重复决定"},
    {"code": "annotation_record_digest_mismatch", "http": 422, "retryable": false, "surface": "api", "description": "records_digest 校验失败"},
    {"code": "annotation_review_self_forbidden", "http": 403, "retryable": false, "surface": "api", "description": "复核人不得是标注人"},
    {"code": "annotation_review_not_pending", "http": 409, "retryable": false, "surface": "api", "description": "复核不在 PENDING/IN_REVIEW，不能操作"},
    {"code": "annotation_review_conflict", "http": 409, "retryable": true, "surface": "api", "description": "复核被他人领取/并发修改；重读后可重试"},
    {"code": "annotation_review_required", "http": 409, "retryable": false, "surface": "api", "description": "提交未完成复核，不能验收/完成"},
    {"code": "annotation_arbitration_required", "http": 409, "retryable": false, "surface": "api", "description": "存在升级项，必须先仲裁"},
    {"code": "annotation_arbitration_not_pending", "http": 409, "retryable": false, "surface": "api", "description": "仲裁不在 PENDING/IN_ARBITRATION，不能操作"},
    {"code": "annotation_arbitration_quorum_not_met", "http": 409, "retryable": false, "surface": "api", "description": "仲裁人数未达法定人数"},
    {"code": "annotation_arbiter_conflict", "http": 403, "retryable": false, "surface": "api", "description": "仲裁人是标注人或首轮复核人，或存在利益冲突"},
    {"code": "gold_set_access_denied", "http": 403, "retryable": false, "surface": "api", "description": "无权访问黄金集或期望答案"},
    {"code": "gold_set_not_active", "http": 409, "retryable": false, "surface": "api", "description": "黄金集未 ACTIVE，不能用于新任务"},
    {"code": "gold_set_schema_incompatible", "http": 409, "retryable": false, "surface": "api", "description": "黄金集 Schema 与任务 Schema 不兼容"},
    {"code": "gold_set_item_exposure_forbidden", "http": 403, "retryable": false, "surface": "api", "description": "黄金集期望答案不得进入标注员响应/日志/导出"},
    {"code": "quality_sample_not_reviewable", "http": 409, "retryable": false, "surface": "api", "description": "抽检样本状态/复核人不允许复核"},
    {"code": "quality_sample_policy_missing", "http": 422, "retryable": false, "surface": "api", "description": "缺少有效抽样策略版本"},
    {"code": "quality_sample_self_review_forbidden", "http": 403, "retryable": false, "surface": "api", "description": "抽检复核人不得是被抽检提交的标注人"},
    {"code": "iaa_report_not_ready", "http": 409, "retryable": true, "surface": "api", "description": "IAA 报告尚未完成，不能读取最终指标"},
    {"code": "iaa_insufficient_overlap", "http": 422, "retryable": false, "surface": "api", "description": "重叠样本不足，无法计算请求的 IAA 指标"},
    {"code": "iaa_source_forbidden", "http": 403, "retryable": false, "surface": "api", "description": "IAA 只能基于真实提交重叠计算，禁止用黄金集或非独立标注冒充"},
    {"code": "annotation_ai_review_required", "http": 422, "retryable": false, "surface": "api", "description": "AI 辅助结果低置信度/高风险，必须人工复核确认"},
    {"code": "annotation_ai_source_invalid", "http": 422, "retryable": false, "surface": "api", "description": "AI 辅助来源缺少模型/版本/Prompt/置信度"},
    {"code": "annotation_workload_unavailable", "http": 422, "retryable": true, "surface": "api", "description": "工作量来源不可用或部分缺失"},
    {"code": "annotation_export_not_supported", "http": 422, "retryable": false, "surface": "api", "description": "阶段 3 不支持训练集导出；应走阶段 4 DatasetVersion"},
    {"code": "annotation_lineage_conflict", "http": 409, "retryable": false, "surface": "api", "description": "标注血缘边重复/成环/跨项目/引用非法节点"},
    {"code": "annotation_metric_unavailable", "http": 422, "retryable": true, "surface": "api", "description": "指标来源/口径版本不可用"},
    {"code": "annotation_outbox_unavailable", "http": 503, "retryable": true, "surface": "api", "description": "outbox/事件基础设施不可用，业务事务回滚"},

    {"code": "iaa_compute_failed", "http": null, "retryable": true, "surface": "job", "description": "IAA 计算失败（数据读取/计算/写入）"},
    {"code": "iaa_insufficient_data", "http": null, "retryable": false, "surface": "job", "description": "重叠样本不足或指标分母为 0；报告状态 INSUFFICIENT_DATA"},
    {"code": "gold_set_evaluation_failed", "http": null, "retryable": true, "surface": "job", "description": "黄金集评估失败"},
    {"code": "annotation_aggregation_failed", "http": null, "retryable": true, "surface": "job", "description": "任务/批次/工作量汇总失败"},
    {"code": "annotation_record_hash_failed", "http": null, "retryable": false, "surface": "job", "description": "标注记录 Hash 计算/校验失败"},
    {"code": "annotation_schema_validation_failed", "http": null, "retryable": false, "surface": "job", "description": "异步 Schema/记录校验失败"},
    {"code": "outbox_publish_failed", "http": null, "retryable": true, "surface": "job", "description": "outbox 事件发布失败；重试/死信，不得静默丢弃"}
  ]
}
