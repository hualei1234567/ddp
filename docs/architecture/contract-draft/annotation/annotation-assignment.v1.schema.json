{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ddp.local/schemas/annotation/annotation-assignment.v1.schema.json",
  "title": "DDP AnnotationAssignment v1（草案）",
  "description": "阶段 3 标注分配。一个分配只属于一个任务/批次；领取校验本人、容量、过期与职责分离。",
  "version": "ddp.stage3/1.0.0-draft",
  "type": "object",
  "required": [
    "assignment_id",
    "project_id",
    "task_id",
    "batch_id",
    "assignee_id",
    "assignment_role",
    "status",
    "planned_item_count",
    "claimed_item_count",
    "submitted_item_count",
    "approved_item_count",
    "planned_minutes",
    "version",
    "created_at",
    "updated_at"
  ],
  "additionalProperties": false,
  "properties": {
    "assignment_id": {"$ref": "#/$defs/uuid"},
    "project_id": {"$ref": "#/$defs/uuid"},
    "task_id": {"$ref": "#/$defs/uuid"},
    "batch_id": {"$ref": "#/$defs/uuid"},
    "assignee_id": {"$ref": "#/$defs/uuid"},
    "assignment_role": {"type": "string", "enum": ["ANNOTATOR", "REVIEWER", "ARBITER"]},
    "status": {"type": "string", "enum": ["ASSIGNED", "CLAIMED", "IN_PROGRESS", "SUBMITTED", "COMPLETED", "REVOKED", "EXPIRED"]},
    "planned_item_count": {"type": "integer", "minimum": 0},
    "claimed_item_count": {"type": "integer", "minimum": 0},
    "submitted_item_count": {"type": "integer", "minimum": 0},
    "approved_item_count": {"type": "integer", "minimum": 0},
    "planned_minutes": {"type": "integer", "minimum": 0},
    "actual_minutes": {"type": ["integer", "null"], "minimum": 0},
    "lease_expires_at": {"oneOf": [{"$ref": "#/$defs/date_time"}, {"type": "null"}]},
    "claimed_at": {"oneOf": [{"$ref": "#/$defs/date_time"}, {"type": "null"}]},
    "submitted_at": {"oneOf": [{"$ref": "#/$defs/date_time"}, {"type": "null"}]},
    "completed_at": {"oneOf": [{"$ref": "#/$defs/date_time"}, {"type": "null"}]},
    "revoked_reason": {"type": ["string", "null"], "maxLength": 1000},
    "version": {"type": "integer", "minimum": 1},
    "created_at": {"$ref": "#/$defs/date_time"},
    "updated_at": {"$ref": "#/$defs/date_time"},
    "created_by": {"$ref": "#/$defs/uuid"},
    "updated_by": {"$ref": "#/$defs/uuid"}
  },
  "$defs": {
    "uuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "date_time": {"type": "string", "format": "date-time"}
  }
}
