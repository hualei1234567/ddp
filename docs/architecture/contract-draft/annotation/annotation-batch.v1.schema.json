{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ddp.local/schemas/annotation/annotation-batch.v1.schema.json",
  "title": "DDP AnnotationBatch v1（草案）",
  "description": "阶段 3 标注批次。批次样本必须属于任务样本集，状态不得领先任务。",
  "version": "ddp.stage3/1.0.0-draft",
  "type": "object",
  "required": [
    "batch_id",
    "project_id",
    "task_id",
    "code",
    "sequence_no",
    "status",
    "planned_item_count",
    "submitted_item_count",
    "approved_item_count",
    "rejected_item_count",
    "rework_count",
    "version",
    "created_at",
    "updated_at"
  ],
  "additionalProperties": false,
  "properties": {
    "batch_id": {"$ref": "#/$defs/uuid"},
    "project_id": {"$ref": "#/$defs/uuid"},
    "task_id": {"$ref": "#/$defs/uuid"},
    "code": {"type": "string", "minLength": 1, "maxLength": 64},
    "name": {"type": ["string", "null"], "maxLength": 200},
    "sequence_no": {"type": "integer", "minimum": 1},
    "status": {"type": "string", "enum": ["PLANNED", "READY", "ASSIGNED", "IN_PROGRESS", "PAUSED", "BLOCKED", "SUBMITTED", "REVIEWING", "ARBITRATION", "ACCEPTED", "REJECTED", "REWORK", "CANCELLED"]},
    "stratum": {"type": ["string", "null"], "maxLength": 100},
    "item_refs": {"type": "array", "items": {"$ref": "#/$defs/uuid"}},
    "planned_item_count": {"type": "integer", "minimum": 0},
    "assignee_ids": {"type": "array", "items": {"$ref": "#/$defs/uuid"}, "uniqueItems": true},
    "reviewer_pool_ids": {"type": "array", "items": {"$ref": "#/$defs/uuid"}, "uniqueItems": true},
    "due_at": {"oneOf": [{"$ref": "#/$defs/date_time"}, {"type": "null"}]},
    "submitted_item_count": {"type": "integer", "minimum": 0},
    "approved_item_count": {"type": "integer", "minimum": 0},
    "rejected_item_count": {"type": "integer", "minimum": 0},
    "rework_count": {"type": "integer", "minimum": 0},
    "quality_summary": {"type": ["object", "null"], "additionalProperties": true},
    "version": {"type": "integer", "minimum": 1},
    "created_at": {"$ref": "#/$defs/date_time"},
    "updated_at": {"$ref": "#/$defs/date_time"},
    "created_by": {"$ref": "#/$defs/uuid"},
    "updated_by": {"$ref": "#/$defs/uuid"}
  },
  "$defs": {
    "uuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "date_time": {"type": "string", "format": "date-time"}
  }
}
