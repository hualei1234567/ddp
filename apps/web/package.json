{
  "name": "ddp-web",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings=0",
    "test": "vitest run",
    "test:integration:stage3": "vitest run src/integration/stage3Annotation.integration.test.ts",
    "test:integration:stage2": "bash scripts/integration/run-stage2-upload.sh",
    "test:integration:stage2:setup": "DDP_IT_SKIP_STORAGE=1 bash scripts/integration/run-stage2-upload.sh --setup-only",
    "test:integration:stage2:smoke": "bash scripts/integration/run-stage2-upload.sh --smoke",
    "contract:check": "python3 scripts/device_contract_snapshot.py --check",
    "contract:update": "python3 scripts/device_contract_snapshot.py --write",
    "format": "prettier --write 'src/**/*.{ts,tsx,css}'",
    "e2e": "bash scripts/e2e/run-e2e.sh",
    "e2e:local": "bash scripts/e2e/run-local-stack.sh"
  },
  "dependencies": {
    "@ant-design/icons": "5.5.2",
    "antd": "5.22.5",
    "dayjs": "1.11.23",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.1"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@playwright/test": "1.65.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "eslint": "9.17.0",
    "eslint-plugin-react-hooks": "5.1.0",
    "eslint-plugin-react-refresh": "0.4.16",
    "globals": "15.14.0",
    "jsdom": "26.1.0",
    "prettier": "3.10.1",
    "typescript": "5.7.2",
    "typescript-eslint": "8.18.2",
    "vite": "6.0.5",
    "vitest": "2.1.8"
  }
}
