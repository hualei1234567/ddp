# DDP 公网生产环境变量模板（开源学习项目安全基线）
# 部署时复制为仓库根目录 `.env`（已在 .gitignore 忽略，切勿提交真实密钥）：
#   cp infra/deploy/env.production.example .env

DDP_ENV=production
DDP_APP_NAME=DDP
DDP_APP_VERSION=0.2.0
DDP_LOG_LEVEL=INFO
DDP_PLATFORM_PHASE=8

# === 1. JWT 认证与安全红线（对齐 config.py::validate_runtime_security）===
# 非 local 环境禁止开启本地 Header 认证后门
DDP_LOCAL_HEADER_AUTH=false
# 请执行 `openssl rand -hex 32` 生成 >=32 字符随机值替换下方占位符
DDP_JWT_SECRET=<REPLACE_WITH_OPENSSL_RAND_HEX_32>
DDP_JWT_ISSUER=ddp
DDP_JWT_AUDIENCE=ddp-api
DDP_JWT_EXPIRE_MINUTES=720
DDP_JWT_LEEWAY_SECONDS=30

# === 2. PostgreSQL 与 Redis 限流 ===
DDP_DB_USER=ddp_prod
DDP_DB_PASSWORD=<REPLACE_WITH_OPENSSL_RAND_HEX_24>
DDP_DB_NAME=ddp
# 供宿主机运行 scripts/ops/issue_jwt.py 时读取（容器内由 compose 覆盖为 @postgres:5432）
DDP_DATABASE_URL=postgresql+psycopg://ddp_prod:<REPLACE_WITH_OPENSSL_RAND_HEX_24>@127.0.0.1:5432/ddp

DDP_RATE_LIMIT_ENABLED=true
DDP_RATE_LIMIT_BACKEND=redis
DDP_RATE_LIMIT_REDIS_URL=redis://redis:6379/0
DDP_RATE_LIMIT_TRUST_FORWARDED_FOR=true

# === 3. 自建 MinIO 对象存储（>10GB 零云存储费方案）===
# 注意：AccessKey 与 SecretKey 严禁使用 minioadmin，且两者不得相同！
DDP_S3_PUBLIC_ENDPOINT=https://s3.ddp.online
DDP_S3_ENDPOINT=https://s3.ddp.online
DDP_S3_ACCESS_KEY=ddp_minio_prod_ak
DDP_S3_SECRET_KEY=<REPLACE_WITH_OPENSSL_RAND_HEX_24>
DDP_S3_BUCKET=ddp-raw
DDP_S3_REGION=us-east-1

# === 4. CORS 与安全响应头（允许 www.ddp.online 前端跨域直连 api.ddp.online）===
# 严禁包含尾斜杠或通配符 *
DDP_CORS_ALLOWED_ORIGINS=["https://www.ddp.online"]
DDP_CORS_ALLOW_CREDENTIALS=false
DDP_HSTS_ENABLED=true
DDP_HSTS_MAX_AGE_SECONDS=31536000

# === 5. 指标保护与每日自动备份 ===
DDP_METRICS_ACCESS_TOKEN=<REPLACE_WITH_OPENSSL_RAND_HEX_32>
DDP_MAINTENANCE_ENABLED=true
DDP_BACKUP_DIR=/backups
DDP_BACKUP_RETENTION_DAYS=7

# === 6. 出站 SSRF 守卫（公网环境必须全部保持 false）===
DDP_TRAINING_ADAPTER_ALLOW_PRIVATE=false
DDP_MODEL_ADAPTER_ALLOW_PRIVATE=false
DDP_WEBHOOK_OUTBOUND_ALLOW_PRIVATE=false
