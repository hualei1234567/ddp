# DDP 反向代理配置。
#
# 为什么是模板：浏览器端没有登录流程（产品侧尚未实现），本地开发栈需要一个
# 身份才能把界面用起来。令牌由环境变量 `DDP_WEB_DEV_AUTH` 提供（形如
# `Bearer eyJ...`），官方 nginx 镜像的 entrypoint 会用 envsubst 渲染
# `/etc/nginx/templates/*.template` → `/etc/nginx/conf.d/default.conf`，
# 且 `NGINX_ENVSUBST_FILTER` 限定只替换这一个变量，`$host` 等 nginx 变量原样保留。
#
# 未配置令牌时 `${DDP_WEB_DEV_AUTH}` 渲染为空 → 注入空 Authorization →
# 后端把空头视为「未提供」，行为与不注入完全一致（见
# `backend/app/api/deps.py::extract_bearer_token`）。
#
# 客户端自己带了 Authorization 就原样透传，不被覆盖。
map $http_authorization $ddp_authorization {
    default $http_authorization;
    ""      "${DDP_WEB_DEV_AUTH}";
}

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    location /api/ {
        proxy_pass http://api:8000/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Request-Id $request_id;
        proxy_set_header Authorization $ddp_authorization;
    }

    location /health {
        proxy_pass http://api:8000/health;
        proxy_set_header Host $host;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
